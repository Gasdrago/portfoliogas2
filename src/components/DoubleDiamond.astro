---
/**
 * Symbole du double diamant : deux losanges accolés, soit quatre demi-losanges.
 * `phase` (0 à 3) met en avant le temps courant : ouvrir, resserrer, ouvrir, resserrer.
 */
interface Props {
  phase?: number;
  label?: string;
  class?: string;
}

const { phase, label, class: className, ...rest } = Astro.props;
---

<svg
  class:list={['dd', className]}
  viewBox="0 0 44 24"
  width="44"
  height="24"
  data-phase={phase}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  {...rest}
>
  <path d="M12 2 2 12l10 10"></path>
  <path d="M12 2l10 10-10 10"></path>
  <path d="M32 2 22 12l10 10"></path>
  <path d="M32 2l10 10-10 10"></path>
</svg>

<style>
  .dd {
    display: block;
    flex: none;
    overflow: visible;
    fill: none;
    stroke: var(--fg-subtle);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dd path {
    transition:
      stroke 0.4s,
      stroke-width 0.4s;
  }

  .dd[data-phase='0'] path:nth-child(1),
  .dd[data-phase='1'] path:nth-child(2),
  .dd[data-phase='2'] path:nth-child(3),
  .dd[data-phase='3'] path:nth-child(4) {
    stroke: var(--accent);
    stroke-width: 2;
  }
</style>
