---
import { widthsFor } from '@/lib/image';
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Attribut sizes de l'image — décrit la largeur rendue. */
  sizes?: string;
  /** Ratio imposé (ex. "16/9", "4/5"). "auto" conserve le ratio natif. */
  ratio?: string;
  fit?: 'cover' | 'contain';
  position?: string;
  reveal?: 'mask' | 'up' | 'fade' | false;
  /** Ouvre l'image en plein écran dans la visionneuse (groupe partagé). */
  lightbox?: string;
  priority?: boolean;
  transitionName?: string;
  class?: string;
  tone?: 'raised' | 'none';
  /** Présente l'image comme une planche posée sur un fond (passe-partout). */
  framed?: boolean;
  style?: string;
}

const {
  src,
  alt,
  caption,
  sizes = '100vw',
  ratio = 'auto',
  fit = 'cover',
  position = 'center',
  reveal = 'mask',
  lightbox,
  priority = false,
  transitionName,
  class: className,
  tone = 'raised',
  framed = false,
  style,
} = Astro.props;

const widths = widthsFor(src, [480, 768, 1080, 1440, 1920]);

let full: { src: string; srcset: string } | undefined;
if (lightbox) {
  const big = await getImage({ src, widths: widthsFor(src, [1080, 1920, 2560]), format: 'webp', quality: 82 });
  full = { src: big.src, srcset: big.srcSet.attribute };
}

const mediaStyle = [
  ratio !== 'auto' ? `aspect-ratio: ${ratio}` : '',
  transitionName ? `view-transition-name: ${transitionName}` : '',
]
  .filter(Boolean)
  .join('; ');
---

<figure class:list={['figure', { 'figure--framed': framed }, className]} style={style}>
  <div
    class:list={['media', 'figure__media', { 'figure__media--flat': tone === 'none' }]}
    style={mediaStyle}
    data-reveal={reveal === 'up' ? '' : reveal || undefined}
  >
    <Image
      src={src}
      alt={alt}
      widths={widths}
      width={Math.max(...widths)}
      sizes={sizes}
      format="webp"
      quality={80}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding={priority ? 'sync' : 'async'}
      style={`object-fit: ${fit}; object-position: ${position}`}
    />
    {
      lightbox && full && (
        <button
          class="figure__zoom"
          type="button"
          data-lightbox={lightbox}
          data-src={full.src}
          data-srcset={full.srcset}
          data-alt={alt}
          data-caption={caption}
          data-cursor="Agrandir"
          aria-label="Agrandir l’image"
        >
          <span class="figure__zoom-icon" aria-hidden="true">+</span>
        </button>
      )
    }
  </div>
  {caption && <figcaption class="figure__caption">{caption}</figcaption>}
</figure>

<style>
  .figure {
    position: relative;
  }

  .figure__media {
    width: 100%;
  }

  .figure--framed .figure__media {
    padding: clamp(0.5rem, 1.5vw, 1.25rem);
    background: var(--frame-bg, var(--bg-raised));
  }

  .figure__media--flat {
    background: transparent;
  }

  .figure__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .figure__zoom {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: var(--space-s);
  }

  .figure__zoom-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--c-night) 70%, transparent);
    color: var(--c-snow);
    font-size: 1.25rem;
    line-height: 1;
    opacity: 0;
    transform: scale(0.8);
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .figure__zoom:hover .figure__zoom-icon,
  .figure__zoom:focus-visible .figure__zoom-icon {
    opacity: 1;
    transform: none;
  }

  @media (hover: none) {
    .figure__zoom-icon {
      opacity: 1;
      transform: none;
    }
  }

  .figure__zoom:focus-visible {
    outline-offset: -4px;
  }

  .figure__caption {
    display: flex;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
</style>
