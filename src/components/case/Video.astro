---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { href } from '@/lib/url';

/**
 * Vidéo muette en boucle, lue seulement à l'écran (scripts/ambient.ts),
 * jamais sous prefers-reduced-motion : l'image fixe reste alors affichée.
 */
interface Props {
  src: string;
  poster: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, poster, alt, caption } = Astro.props;
---

<figure class="vid">
  <div class="vid__frame media">
    <Image src={poster} alt={alt} widths={[768, 1280]} width={1280} sizes="100vw" format="webp" loading="lazy" />
    <video data-ambient muted loop playsinline preload="none" disablepictureinpicture aria-hidden="true">
      <source src={href(src)} type="video/mp4" />
    </video>
  </div>
  {caption && <figcaption class="figure__caption vid__caption">{caption}</figcaption>}
</figure>

<style>
  .vid__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .vid__frame :is(img, video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vid__frame video {
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .vid__frame video:global(.is-playing) {
    opacity: 1;
  }

  .vid__caption {
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
</style>
