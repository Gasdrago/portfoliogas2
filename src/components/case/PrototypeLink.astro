---
import type { Project } from '@/data/projects';

/** Lien vers le prototype en ligne — placé après le contenu de l'étude de cas. */
interface Props {
  project: Project;
}

const { project } = Astro.props;
const proto = project.prototype;
---

{
  proto && (
    <section class="proto container" aria-labelledby={`proto-${project.slug}`}>
      <a class="proto__link" href={proto.href} target="_blank" rel="noopener" data-cursor="Ouvrir">
        <span class="t-meta proto__kicker">Prototype en ligne</span>
        <span id={`proto-${project.slug}`} class="proto__title">
          {proto.label}
          <span class="arrow arrow--ne" aria-hidden="true">↗</span>
        </span>
        <span class="sr-only">(ouvre un nouvel onglet)</span>
      </a>
    </section>
  )
}

<style>
  .proto {
    padding-top: var(--space-2xl);
  }

  .proto__link {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-l);
    border: 1px solid var(--border-strong);
    transition:
      background var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .proto__link:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .proto__link:hover .proto__kicker {
    color: inherit;
  }

  .proto__title {
    font-size: var(--step-3);
    font-weight: 600;
    font-stretch: 84%;
    letter-spacing: var(--tracking-display);
    line-height: 1;
  }
</style>
