---
/**
 * Section « Démarche » de l'accueil.
 * Une sculpture de fils tendus (Three.js) traverse quatre temps au défilement :
 * elle s'ouvre, converge, s'ouvre à nouveau, puis se stabilise.
 * Sans WebGL ou en mouvement réduit, chaque temps affiche une vue fixe de la sculpture.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SectionHead from '@/components/SectionHead.astro';
import DoubleDiamond from '@/components/DoubleDiamond.astro';
import { getProject } from '@/data/projects';
import { href } from '@/lib/url';

// Vues fixes rendues depuis la scène (voir scripts/demarche-stills.mjs).
const stillFiles = import.meta.glob<{ default: ImageMetadata }>('@/assets/demarche/etape-*.png', { eager: true });
const stills = Object.keys(stillFiles)
  .sort()
  .map((k) => stillFiles[k].default);

const steps = [
  {
    id: 'observer',
    verb: 'Observer',
    slug: 'inrae',
    client: 'INRAE',
    intent: 'Partir du terrain avant de proposer.',
    shape: 'Les fils partent dans toutes les directions : rien n’est encore trié.',
    stillAlt: 'Sculpture, premier état : sept fils tendus entre un banc et un portique, qui se croisent en désordre.',
  },
  {
    id: 'definir',
    verb: 'Définir',
    slug: 'renault-center-view',
    client: 'Renault',
    intent: 'Ramener le sujet à une seule question.',
    shape: 'Tous les fils passent par un seul œillet.',
    stillAlt: 'Sculpture, deuxième état : les sept fils convergent vers un œillet orange, puis repartent en éventail.',
  },
  {
    id: 'explorer',
    verb: 'Explorer',
    slug: 'mobotix-sun-scan',
    client: 'Mobotix',
    intent: 'Rouvrir, pour comparer plusieurs réponses.',
    shape: 'Trois faisceaux traversent un cadre, puis se rejoignent.',
    stillAlt: 'Sculpture, troisième état : les fils se séparent en trois faisceaux à travers un cadre intermédiaire, puis se rejoignent.',
  },
  {
    id: 'eprouver',
    verb: 'Éprouver',
    slug: 'manuels-scolaires-numeriques',
    client: 'Comp-AI-gnons',
    intent: 'Mettre à l’essai, et dire ce que l’essai permet d’affirmer.',
    shape: 'Les fils se rangent en parallèle, tenus par une cage.',
    stillAlt: 'Sculpture, quatrième état : les fils, parallèles, montent d’un même mouvement dans une cage.',
  },
].map((s, i) => ({
  ...s,
  n: String(i + 1).padStart(2, '0'),
  phase: i,
  // Double diamant : on ouvre, on resserre, deux fois.
  mode: i % 2 ? 'Resserrer' : 'Ouvrir',
  project: getProject(s.slug),
  still: stills[i],
}));
---

<section class="dm section" id="demarche" data-demarche aria-labelledby="demarche-title">
  <div class="container">
    <SectionHead index="01" label="Démarche" id="demarche-title">
      <Fragment slot="title">
        <span class="line"><span>Observer, définir,</span></span>
        <span class="line"><span><em class="t-serif">explorer, éprouver.</em></span></span>
      </Fragment>
      <div slot="aside">
        <p>
          Design, conseil ou ingénierie : je travaille en quatre temps. Une même sculpture les traverse : elle
          s’ouvre, converge, s’ouvre à nouveau, puis se stabilise. Chaque temps renvoie à un projet où il a
          compté.
        </p>
        <p class="dm__method">
          <DoubleDiamond />
          <span>Méthode du double diamant : ouvrir, resserrer, deux fois.</span>
        </p>
      </div>
    </SectionHead>
  </div>

  <div class="dm__scrolly container">
      <!-- Sculpture -->
      <div class="dm__stage" data-stage>
        <div class="dm__plate">
          <p class="dm__plate-label t-meta" aria-hidden="true">
            <span>Les lignes de tension</span>
            <span data-count>01 / 04</span>
          </p>
          <canvas
            class="dm__canvas"
            role="img"
            aria-label="Sculpture de fils tendus entre un banc et un portique. Elle change de forme à chaque temps de la démarche ; chaque temps est décrit dans le texte."
          ></canvas>
          <p class="dm__caption" data-caption aria-hidden="true">{steps[0].shape}</p>
          <div class="dm__bottom">
            <p class="dm__dd">
              <DoubleDiamond phase={0} data-dd />
              <span>Double diamant</span>
            </p>
            <nav class="dm__rail" aria-label="Les quatre temps">
              <ol role="list">
                {
                  steps.map((s) => (
                    <li>
                      <a href={`#${s.id}`} data-rail={s.id}>
                        <span class="dm__rail-n">{s.n}</span>
                        <span class="dm__rail-name">{s.verb}</span>
                        <span class="dm__rail-mode">{s.mode}</span>
                      </a>
                    </li>
                  ))
                }
              </ol>
            </nav>
          </div>
        </div>
      </div>

      <!-- Les quatre temps -->
      <div class="dm__steps">
        {
          steps.map((s) => (
            <section class="step" id={s.id} data-step data-shape={s.shape} aria-labelledby={`${s.id}-title`}>
              <div class="step__inner">
                {s.still && (
                  <figure class="step__still">
                    <Image
                      src={s.still}
                      alt={s.stillAlt}
                      widths={[480, 800, 1200]}
                      width={1200}
                      sizes="(min-width: 900px) 46rem, 100vw"
                      format="webp"
                      quality={84}
                      loading="lazy"
                    />
                  </figure>
                )}
                <p class="step__kicker t-meta">
                  <DoubleDiamond phase={s.phase} label={`Double diamant, temps ${s.phase + 1} sur 4 : ${s.mode.toLowerCase()}`} />
                  <span>{s.n} / 04 · {s.mode}</span>
                  <span>{s.intent}</span>
                </p>
                <h3 class="step__title" id={`${s.id}-title`}>
                  {s.verb}
                  <em class="t-serif">{s.client}</em>
                </h3>
                <p class="step__shape">{s.shape}</p>

                {s.id === 'observer' && (
                  <div class="fact">
                    <p class="t-meta">Constat de terrain</p>
                    <p class="fact__main">
                      Réticence au numérique, méconnaissance des outils, peur de l’endettement.
                    </p>
                    <p class="fact__note">
                      Trois freins relevés en quatre entretiens. Ils éclairent une décision précise : celle d’un
                      agriculteur qui envisage d’adopter une technologie numérique.
                    </p>
                  </div>
                )}

                {s.id === 'definir' && (
                  <div class="fact">
                    <p class="t-meta">La question que j’ai cherché à résoudre</p>
                    <p class="fact__main fact__main--quote">
                      Comment une IA peut-elle proposer sans s’imposer, quand je conduis ?
                    </p>
                    <p class="fact__note">
                      Point de départ : un tableau de bord surchargé, alors que 87&nbsp;% des usages tiennent en
                      trois applications.
                    </p>
                  </div>
                )}

                {s.id === 'explorer' && (
                  <div class="fact">
                    <p class="t-meta">Les pistes envisagées avant Sun Scan</p>
                    <ol class="fact__list" role="list">
                      <li><span><strong>Un gadget pour téléphone</strong> — relier le téléphone à la caméra.</span></li>
                      <li><span><strong>Un mini-vigile assistant</strong> — mettre l’intelligence du robot au service de l’usager.</span></li>
                      <li><span><strong>Un habillage de caméra</strong> — rendre la caméra plus discrète.</span></li>
                    </ol>
                    <p class="fact__note">
                      Les pistes ont fusionné : une application fait la jonction. Sun Scan est une caméra-bouée
                      et son application.
                    </p>
                  </div>
                )}

                {s.id === 'eprouver' && (
                  <div class="fact">
                    <p class="t-meta">Ce qui a été mis à l’essai</p>
                    <p class="fact__main">
                      Une affiche à QR code dans trois lieux : 55 scans. Puis une démo web, essayée par des élèves.
                    </p>
                    <p class="fact__note">
                      <strong>Ce que le dossier permet d’en dire :</strong> le dispositif et le nombre de scans
                      sont documentés. Il ne présente pas de résultats chiffrés du test, ni de manette physique :
                      la manette est modélisée en 3D.
                    </p>
                  </div>
                )}

                <a class="pj" href={href(`projets/${s.project.slug}/`)}>
                  <Image
                    class="pj__img"
                    src={s.project.thumb}
                    alt=""
                    widths={[160, 320, 480]}
                    width={320}
                    sizes="9rem"
                    format="webp"
                    quality={80}
                    loading="lazy"
                  />
                  <span class="pj__body">
                    <span class="t-meta">Le projet</span>
                    <span class="pj__title">{s.project.title}</span>
                    <span class="pj__proof">{s.project.proof}</span>
                    <span class="pj__go">
                      Lire l’étude {s.client}
                      <span class="arrow" aria-hidden="true">→</span>
                    </span>
                  </span>
                </a>
              </div>
            </section>
          ))
        }
      </div>
    </div>

  <footer class="dm__outro container">
    <p class="dm__outro-text">
      Les quatre temps ne se suivent pas toujours dans cet ordre. Ils se retrouvent dans chaque projet.
    </p>
    <a class="link link--quiet t-meta" href={href('prototypes/ma-demarche-essais/')}>Coulisses : fils ou blocs</a>
  </footer>
</section>

<script>
  import { hasWebGL } from '@/scripts/demarche/support';

  const root = document.querySelector<HTMLElement>('[data-demarche]');
  const canvas = root?.querySelector<HTMLCanvasElement>('.dm__canvas');
  const stageEl = root?.querySelector<HTMLElement>('[data-stage]');
  const stepEls = root ? [...root.querySelectorAll<HTMLElement>('[data-step]')] : [];
  const railEls = root ? [...root.querySelectorAll<HTMLAnchorElement>('[data-rail]')] : [];
  const captionEl = root?.querySelector<HTMLElement>('[data-caption]');
  const countEl = root?.querySelector<HTMLElement>('[data-count]');
  const diamondEl = root?.querySelector<SVGElement>('[data-dd]');
  let shown = -1;

  const params = new URLSearchParams(location.search);
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wantsStatic = params.has('fixe') || reduced;

  /**
   * Progression continue (0 → 3). Une étape devient courante quand son titre atteint la ligne de lecture ;
   * la sculpture tient sa forme pendant la lecture, puis se transforme à l'approche du titre suivant.
   */
  function progress(): number {
    const wide = window.matchMedia('(min-width: 900px)').matches;
    // Sur téléphone la sculpture occupe le haut de l'écran : la ligne de lecture est plus basse.
    const focus = window.innerHeight * (wide ? 0.5 : 0.62);
    const [hold, span] = wide ? [0.38, 0.5] : [0.55, 0.4];
    const anchors = stepEls.map((el) => (el.firstElementChild ?? el).getBoundingClientRect().top);
    if (focus <= anchors[0]) return 0;
    for (let i = 0; i < anchors.length - 1; i++) {
      if (focus <= anchors[i + 1]) {
        const f = (focus - anchors[i]) / (anchors[i + 1] - anchors[i]);
        return i + Math.min(Math.max((f - hold) / span, 0), 1);
      }
    }
    return anchors.length - 1;
  }

  function markCurrent(p: number) {
    const i = Math.round(p);
    railEls.forEach((a, k) => {
      if (k === i) a.setAttribute('aria-current', 'step');
      else a.removeAttribute('aria-current');
    });
    stepEls.forEach((el, k) => el.classList.toggle('is-current', k === i));
    if (i === shown) return;
    shown = i;
    diamondEl?.setAttribute('data-phase', String(i));
    if (countEl) countEl.textContent = `0${i + 1} / 04`;
    if (captionEl) captionEl.textContent = stepEls[i]?.dataset.shape ?? '';
  }

  async function start() {
    if (!root || !canvas || !stageEl) return;
    const [{ createStage }, { createThreads }] = await Promise.all([
      import('@/scripts/demarche/stage'),
      import('@/scripts/demarche/threads'),
    ]);

    const toStatic = () => root.classList.remove('is-3d');
    root.classList.add('is-3d');
    const stage = createStage(canvas, { onContextLost: toStatic, halfWidth: 2.5, halfHeight: 1.3, fit: 1.05, elevation: 0.38 });
    stage.add(createThreads());

    let ticking = false;
    const update = (immediate = false) => {
      ticking = false;
      const p = progress();
      stage.setTarget(p, immediate);
      markCurrent(p);
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => update());
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update(true);

    // Pause du rendu quand la sculpture est hors écran.
    new IntersectionObserver(([entry]) => stage.setActive(entry.isIntersecting)).observe(stageEl);
  }

  if (root && !wantsStatic && hasWebGL()) {
    start().catch(() => root.classList.remove('is-3d'));
  }
</script>

<style>

  .step__title em {
    font-weight: 400;
    letter-spacing: 0;
  }

  .dm {
    padding-top: var(--space-xl);
  }

  /* ---- Défilement ------------------------------------------------------ */
  .dm__stage {
    display: none;
  }

  .is-3d .dm__stage {
    position: sticky;
    top: 0;
    z-index: 2;
    display: block;
    /* Le haut de la scène reste libre pour l'en-tête, qui revient quand on remonte. */
    height: calc(44svh + var(--header-h));
    min-height: 17rem;
    padding-top: var(--header-h);
    margin-inline: calc(var(--gutter) * -1);
    background: var(--bg);
  }

  /* La planche : un fond teinté qui cadre la sculpture. */
  .dm__plate {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-2xs) var(--gutter) 0;
    border-block: 1px solid var(--border);
    background: var(--bg-raised);
  }

  .dm__plate-label,
  .dm__caption {
    display: none;
  }

  .dm__canvas {
    display: block;
    flex: 1 1 0;
    width: 100%;
    min-height: 0;
  }

  .dm__bottom {
    display: flex;
    gap: var(--space-s);
    align-items: flex-start;
  }

  .dm__dd {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: var(--space-2xs);
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-caps);
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dm__dd span {
    display: none;
  }

  .dm__method {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    margin-top: var(--space-s);
    color: var(--fg-muted);
    font-size: var(--step--1);
  }

  /* Repères des quatre temps */
  .dm__rail {
    flex: 1;
    min-width: 0;
  }

  .dm__rail ol {
    display: flex;
    gap: var(--space-2xs);
  }

  .dm__rail li {
    flex: 1;
    min-width: 0;
  }

  .dm__rail a {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
    align-content: flex-start;
    min-height: 2.75rem;
    padding-top: var(--space-2xs);
    border-top: 2px solid var(--border-strong);
    color: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-caps);
    line-height: 1.5;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 0.3s,
      border-color 0.3s;
  }

  .dm__rail a:not([aria-current]) {
    border-color: var(--border);
  }

  .dm__rail a[aria-current] {
    border-color: var(--accent);
    color: var(--fg);
  }

  .dm__rail-name,
  .dm__rail-mode {
    display: none;
  }

  .dm__rail-mode {
    flex-basis: 100%;
    opacity: 0.75;
  }

  @media (min-width: 480px) {
    .dm__rail-name,
    .dm__dd span {
      display: inline;
    }
  }

  /* ---- Étapes ---------------------------------------------------------- */
  .step {
    padding-block: var(--space-xl);
    border-top: 1px solid var(--border);
    scroll-margin-top: var(--header-h);
  }

  .is-3d .step {
    display: flex;
    align-items: flex-start;
    min-height: 82svh;
    padding-block: var(--space-l) var(--space-xl);
    border-top: 0;
    scroll-margin-top: calc(42svh + var(--header-h));
  }

  .step__inner {
    width: 100%;
    max-width: 34rem;
  }

  .is-3d .step__inner {
    opacity: 0.4;
    transition: opacity 0.5s;
  }

  .is-3d .step.is-current .step__inner,
  .is-3d .step:focus-within .step__inner {
    opacity: 1;
  }

  .step__still {
    margin: 0 0 var(--space-m);
  }

  .is-3d .step__still {
    display: none;
  }

  .step__still img {
    display: block;
    width: 100%;
    height: auto;
  }

  .step__kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em 1em;
    align-items: center;
  }

  .step__kicker span:last-child {
    flex-basis: 100%;
  }

  .step__kicker span:first-of-type {
    color: var(--accent-text);
  }

  .step__title {
    display: flex;
    flex-direction: column;
    gap: 0.1em;
    margin-block: var(--space-s);
    font-size: var(--step-4);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
  }

  .step__title em {
    align-self: flex-start;
    padding-bottom: 0.08em;
    border-bottom: 2px solid var(--accent);
    font-size: 0.5em;
    line-height: 1.1;
  }

  .step__shape {
    color: var(--fg-subtle);
    font-size: var(--step--1);
  }

  .fact {
    margin-block: var(--space-m);
    padding-top: var(--space-s);
    border-top: 1px solid var(--border-strong);
  }

  .fact__main {
    margin-block: var(--space-2xs) var(--space-xs);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: var(--tracking-title);
    text-wrap: balance;
  }

  .fact__main--quote {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.15;
  }

  .fact__list {
    display: grid;
    gap: var(--space-2xs);
    margin-block: var(--space-xs);
    counter-reset: piste;
  }

  .fact__list li {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    counter-increment: piste;
    line-height: 1.4;
  }

  .fact__list li::before {
    content: counter(piste);
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .fact__note {
    color: var(--fg-muted);
    line-height: var(--lh-body);
  }

  .fact__note strong {
    color: var(--fg);
  }

  /* Carte du projet associé */
  .pj {
    display: grid;
    grid-template-columns: clamp(5.5rem, 26%, 9rem) 1fr;
    gap: var(--space-s);
    align-items: stretch;
    padding: var(--space-xs);
    border: 1px solid var(--border);
    background: var(--bg-raised);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.3s,
      background-color 0.3s;
  }

  .pj:hover,
  .pj:focus-visible {
    border-color: var(--fg);
  }

  .pj__img {
    width: 100%;
    height: 100%;
    min-height: 6.5rem;
    object-fit: cover;
  }

  .pj__body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    justify-content: center;
    min-width: 0;
  }

  .pj__title {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: var(--tracking-title);
  }

  .pj__proof {
    color: var(--fg-muted);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .pj__go {
    display: inline-flex;
    gap: 0.5em;
    align-items: center;
    margin-top: 0.35rem;
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  /* ---- Fin ------------------------------------------------------------- */
  .dm__outro {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
    align-items: baseline;
    justify-content: space-between;
    padding-block: var(--space-l) 0;
    border-top: 1px solid var(--border);
  }

  .dm__outro-text {
    max-width: 34ch;
    font-size: var(--step-1);
    font-weight: 500;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-title);
  }

  /* ---- Grand écran : texte à gauche, sculpture fixe à droite ------------ */
  @media (min-width: 900px) {
    .is-3d .dm__scrolly {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-l);
    }

    .is-3d .dm__steps {
      grid-column: 1;
      grid-row: 1;
    }

    .is-3d .dm__stage {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      height: 100svh;
      padding-block: var(--space-m);
      /* La planche va jusqu'au bord droit de l'écran. */
      margin-inline: 0 calc(var(--gutter) * -1);
      background: none;
    }

    .dm__plate {
      padding: var(--space-s) var(--space-m) var(--space-s);
      border: 0;
    }

    .dm__plate-label {
      display: flex;
      justify-content: space-between;
    }

    .dm__caption {
      display: block;
      min-height: 2.6em;
      margin-bottom: var(--space-s);
      max-width: 24ch;
      font-family: var(--font-serif);
      font-size: var(--step-2);
      font-style: italic;
      line-height: 1.15;
    }

    .dm__bottom {
      gap: var(--space-m);
    }

    .dm__rail-mode {
      display: block;
    }

    /* La phrase qui décrit la forme est affichée sous la sculpture. */
    .is-3d .step__shape {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .is-3d .step {
      align-items: center;
      min-height: 100svh;
      padding-block: var(--space-xl);
