---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '@fontsource-variable/instrument-sans/standard.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import fontSans from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-standard-normal.woff2?url';
import '@/styles/tokens.css';
import '@/styles/base.css';

import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Cursor from '@/components/Cursor.astro';
import Lightbox from '@/components/Lightbox.astro';
import { site } from '@/data/site';
import { href } from '@/lib/url';
import defaultOg from '@/assets/projects/renault/28.png';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  /** Thème de la page entière (voir tokens.css). */
  theme?: string;
  /** Masque la section contact en pied de page (ex. 404). */
  bareFooter?: boolean;
}

const { title, description = site.description, image = defaultOg, theme, bareFooter = false } = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = Astro.site ? new URL(og.src, Astro.site).href : og.src;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f1efea" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    <link rel="preload" href={fontSans} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body data-theme={theme}>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter bare={bareFooter} />
    <Lightbox />
    <Cursor />
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
