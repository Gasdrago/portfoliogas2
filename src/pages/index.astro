---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import Demarche from '@/components/Demarche.astro';
import DoubleDiamond from '@/components/DoubleDiamond.astro';
import LabStrip from '@/components/LabStrip.astro';
import { projects, selections, getProject } from '@/data/projects';
import { site } from '@/data/site';
import { href } from '@/lib/url';

// Les quatre temps de la démarche, annoncés dès le premier écran.
const heroSteps = [
  { id: 'observer', verb: 'Observer', project: getProject('inrae') },
  { id: 'definir', verb: 'Définir', project: getProject('renault-center-view') },
  { id: 'explorer', verb: 'Explorer', project: getProject('mobotix-sun-scan') },
  { id: 'eprouver', verb: 'Éprouver', project: getProject('manuels-scolaires-numeriques') },
];

const lectures = selections.map((sel) => ({
  ...sel,
  projects: projects.filter((p) => p.selection === sel.name),
}));

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  sameAs: [site.linkedin],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'CY École de Design' },
    { '@type': 'CollegeOrUniversity', name: 'CY Tech' },
  ],
};
---

<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personLd)} />

  <!-- ================================================================ HÉROS -->
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero__top t-meta">
      <p><span class="t-index">GB</span> Portfolio</p>
      <p class="hero__top-mid">{site.education.schools}</p>
      <p>{site.education.period}</p>
    </div>

    <h1 id="hero-title" class="hero__title" data-lines="load">
      <span class="sr-only">{site.name}, </span>
      <span class="line"><span>Designer global</span></span>
      <span class="line"><span><em class="hero__amp t-serif">&amp;</em> ingénieur</span></span>
      <span class="line"><span>informatique.</span></span>
    </h1>

    <div class="hero__intro">
      <p class="hero__status" data-reveal="load" style="--i: 3">
        <span class="hero__dot" aria-hidden="true"></span>
        <span>En recherche de stage — conseil en transformation &amp; innovation, ingénierie logicielle et industrielle</span>
      </p>
      <p class="hero__lead" data-reveal="load" style="--i: 4">
        Je pars du terrain pour <em class="t-serif">cadrer</em> un problème, je <em class="t-serif">conçois</em> la réponse et je la rends <em class="t-serif">testable</em> : maquette, prototype, démonstration.
      </p>
      <ul role="list" class="hero__cta" data-reveal="load" style="--i: 5">
        <li>
          <a class="btn" href="#demarche">La démarche <span class="arrow" aria-hidden="true">↓</span></a>
        </li>
        <li>
          <a class="btn btn--ghost" href={href('projets/')}>Tous les projets <span class="arrow" aria-hidden="true">→</span></a>
        </li>
      </ul>
    </div>

    <nav class="hero__steps" aria-label="Les quatre temps de la démarche" data-reveal="load" style="--i: 2">
      <p class="hero__steps-head t-meta">
        <DoubleDiamond />
        <span>Ma démarche</span>
      </p>
      <ol role="list">
        {
          heroSteps.map((st, i) => (
            <li>
              <a href={`#${st.id}`}>
                <span class="t-index">0{i + 1}</span>
                <span class="hero__steps-verb">{st.verb}</span>
                <span class="hero__steps-client t-serif">{st.project.client === 'Région Île-de-France' ? 'Comp-AI-gnons' : st.project.client}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="hero__bottom t-meta">
      <p><span class="t-meta--fg">{site.companyProjects}</span> projets d’entreprises</p>
      <a href={href(site.cv)} class="hero__scroll link link--quiet" download>Télécharger le CV <span class="arrow" aria-hidden="true">↓</span></a>
    </div>
  </section>

  <!-- ============================================================= DÉMARCHE -->
  <Demarche />

  <!-- ============================================================== PROJETS -->
  <section id="projets" class="section container" aria-labelledby="lectures-title">
    <SectionHead index="02" label="Projets" id="lectures-title">
      <Fragment slot="title">
        <span class="line"><span>Six projets,</span></span>
        <span class="line"><span><em class="t-serif">deux façons de les lire.</em></span></span>
      </Fragment>
      <p slot="aside">
        Selon ce que vous cherchez : une démarche de cadrage et de recommandation, ou un objet conçu,
        modélisé et démontré.
        <br /><a class="link" href={href('projets/')}>Voir tous les projets <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </SectionHead>

    <div class="lectures">
      {
        lectures.map((l) => (
          <section class="lecture" id={`lecture-${l.id}`} aria-labelledby={`lecture-${l.id}-title`}>
            <header class="lecture__head" data-reveal>
              <h3 class="lecture__name" id={`lecture-${l.id}-title`}>
                {l.name}
              </h3>
              <p class="lecture__verbs t-serif">{l.verbs}</p>
            </header>
            <ol role="list" class="lecture__list">
              {l.projects.map((p, i) => (
                <li data-reveal style={`--i: ${i + 1}`}>
                  <a class="lecture__row" href={href(`projets/${p.slug}/`)} data-astro-prefetch>
                    <span class="t-index">{p.index}</span>
                    <span class="lecture__project">
                      <span class="lecture__title">
                        {p.client} <span class="t-serif">— {p.title}</span>
                      </span>
                      <span class="lecture__proof">{p.proof}</span>
                    </span>
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </section>

  <!-- ==================================================================== LAB -->
  <section class="section lab-teaser" aria-labelledby="lab-title">
    <div class="container">
      <SectionHead index="03" label="Lab" id="lab-title">
        <Fragment slot="title">
          <span class="line"><span>Typographie, 3D,</span></span>
          <span class="line"><span><em class="t-serif">image.</em></span></span>
        </Fragment>
        <p slot="aside">
          Les exercices où la main précède la méthode : lettrage, modélisation, lumière et composition.
          <br /><a class="link" href={href('lab/')}>Ouvrir le Lab <span class="arrow" aria-hidden="true">→</span></a>
        </p>
      </SectionHead>
    </div>
    <LabStrip />
  </section>

</Base>

<style>
  /* ---- Héros ------------------------------------------------------------ */
  .hero {
    --hero-size: 16.4vw;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: var(--space-l);
    align-content: space-between;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + var(--space-m));
    padding-bottom: var(--space-m);
  }

  .hero__top,
  .hero__bottom {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--border);
  }

  .hero__top p {
    display: flex;
    gap: var(--space-xs);
  }

  .hero__top-mid {
    display: none !important;
  }

  .hero__bottom {
    border-bottom: 0;
    border-top: 1px solid var(--border);
    padding: var(--space-xs) 0 0;
    align-items: baseline;
  }

  .hero__status {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    line-height: 1.5;
  }

  .hero__dot {
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--c-signal);
    translate: 0 -0.05em;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding: 0;
  }

  .hero__title {
    grid-column: 1 / -1;
    font-size: var(--hero-size);
    font-weight: 600;
    font-stretch: 76%;
    line-height: 0.88;
    letter-spacing: -0.045em;
    word-spacing: 0.06em;
    text-wrap: nowrap;
  }

  .hero__amp {
    display: inline-block;
    font-size: 1.08em;
    line-height: 0;
    color: var(--c-signal);
    margin-right: -0.04em;
  }

  .hero__intro {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-m);
  }

  .hero__lead {
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: 34ch;
    letter-spacing: -0.01em;
  }

  .hero__lead em {
    font-size: 1.1em;
  }

  .hero__domains .tag {
    color: var(--fg);
  }

  /* Les quatre temps, annoncés à droite du premier écran */
  .hero__steps {
    grid-column: 1 / -1;
  }

  .hero__steps-head {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    padding-bottom: var(--space-xs);
  }

  .hero__steps a {
    display: grid;
    grid-template-columns: 2.25rem auto 1fr;
    gap: var(--space-xs);
    align-items: baseline;
    padding-block: 0.55rem;
    border-top: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .hero__steps li:last-child a {
    border-bottom: 1px solid var(--border);
  }

  .hero__steps-verb {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    transition: color var(--dur-2);
  }

  .hero__steps-client {
    justify-self: end;
    color: var(--fg-muted);
    font-size: var(--step-0);
  }

  .hero__steps a:hover .hero__steps-verb,
  .hero__steps a:focus-visible .hero__steps-verb {
    color: var(--accent-text);
  }

  .hero__scroll {
    color: var(--fg);
  }

  @media (min-width: 768px) {
    .hero {
      /* Plafonné aussi par la hauteur : le premier écran reste lisible en entier */
      --hero-size: min(clamp(3rem, 0.5rem + 11vw, 13rem), 19svh);
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .hero__top-mid {
      display: flex !important;
    }

    .hero__intro {
      grid-column: 1 / 8;
      grid-row: 3;
      align-self: end;
    }

    .hero__steps {
      grid-column: 8 / -1;
      grid-row: 3;
      align-self: end;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-rows: auto auto 1fr auto;
    }

    .hero__title {
      grid-row: 2;
      z-index: 1;
      pointer-events: none;
    }

    .hero__steps {
      grid-column: 9 / -1;
      grid-row: 3;
      align-self: end;
    }

    .hero__intro {
      grid-row: 3;
      grid-column: 1 / 7;
      align-self: end;
    }
  }

  /* Apparition au chargement */
  @media (prefers-reduced-motion: no-preference) {
    .hero__top,
    .hero__bottom {
      animation: hero-fade 1s var(--ease-out) 0.6s both;
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }

  /* ---- Lectures --------------------------------------------------------- */
  .section--tight {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .lectures {
    display: grid;
    gap: var(--space-xl) var(--col-gap);
  }

  @media (min-width: 1024px) {
    .lectures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: calc(var(--col-gap) * 3);
    }
  }

  .lecture {
    scroll-margin-top: calc(var(--header-h) + var(--space-m));
  }

  .lecture__head {
    display: grid;
    gap: var(--space-3xs);
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--border-strong);
  }

  .lecture__name {
    font-size: var(--step-3);
    font-stretch: 84%;
    letter-spacing: var(--tracking-display);
    line-height: 1;
  }

  .lecture__verbs {
    font-size: var(--step-1);
    color: var(--fg-muted);
  }

  .lecture__row {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    gap: var(--space-xs);
    align-items: baseline;
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--border);
    transition: padding var(--dur-2) var(--ease-out);
  }

  .lecture__row:hover {
    padding-left: var(--space-xs);
  }

  .lecture__project {
    display: grid;
    gap: var(--space-3xs);
  }

  .lecture__title {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .lecture__title .t-serif {
    font-weight: 400;
    font-size: 1.06em;
  }

  .lecture__proof {
    font-size: var(--step--1);
    color: var(--fg-muted);
  }

  /* ---- Lab -------------------------------------------------------------- */
  .lab-teaser {
    overflow: hidden;
  }
</style>
