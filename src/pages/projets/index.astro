---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHead from '@/components/PageHead.astro';
import SectionHead from '@/components/SectionHead.astro';
import ProjectIndex from '@/components/ProjectIndex.astro';
import { projects, selections } from '@/data/projects';
import { href } from '@/lib/url';
---

<Base
  title="Projets"
  description="Six études de cas de Gaspard Bayle, en deux lectures : conseil & innovation (La Poste, EvoBIM, INRAE) et produit & prototype (Main levée, Sun Scan, Comp-AI-gnons)."
>
  <PageHead kicker="(Projets) Études de cas" lines={['Du terrain', 'à l’interface.']} serifLine={1}>
    <p>
      Six études de cas, de l’analyse d’usage au prototype. Chacune dit ce qui a été cherché, ce qui a
      été produit et ce qui le prouve.
    </p>
  </PageHead>

  <section class="container works" aria-label="Études de cas">
    <div class="filter" role="group" aria-label="Filtrer par lecture" data-filter>
      <button class="filter__btn" type="button" aria-pressed="true" data-filter-value="all">
        Tous <span class="filter__n">{projects.length}</span>
      </button>
      {
        selections.map((sel) => (
          <button class="filter__btn" type="button" aria-pressed="false" data-filter-value={sel.id}>
            {sel.name} <span class="filter__n">{projects.filter((p) => p.selection === sel.name).length}</span>
          </button>
        ))
      }
    </div>
    <ol role="list" class="works__list">
      {
        projects.map((p, i) => (
          <li
            class:list={['work', { 'work--reverse': i % 2 === 1 }]}
            data-selection={selections.find((sel) => sel.name === p.selection)?.id}
          >
            <a
              class="work__media media"
              href={href(`projets/${p.slug}/`)}
              data-reveal="mask"
              data-cursor="Voir le projet"
              tabindex="-1"
              aria-hidden="true"
            >
              <Image
                src={p.cover}
                alt=""
                widths={[768, 1080, 1440]}
                width={1440}
                sizes="(min-width: 1024px) 58vw, 100vw"
                format="webp"
                quality={80}
                loading={i === 0 ? 'eager' : 'lazy'}
                style={`view-transition-name: cover-${p.slug}`}
              />
            </a>
            <div class="work__text">
              <p class="t-meta work__meta" data-reveal>
                <span class="t-index">{p.index}</span>
                <span>{p.client}</span>
                {p.year && <span class="work__year">{p.year}</span>}
              </p>
              <h2 class="work__title" data-reveal style="--i: 1">
                <a href={href(`projets/${p.slug}/`)} class="work__link" data-cursor="Voir le projet" data-astro-prefetch>
                  {p.title}
                </a>
              </h2>
              <p class="work__q t-serif" data-reveal style="--i: 2">{p.question}</p>
              <dl class="work__facts" data-reveal style="--i: 3">
                <div>
                  <dt class="t-meta">Preuve</dt>
                  <dd>{p.proof}</dd>
                </div>
                <div>
                  <dt class="t-meta">Livrables</dt>
                  <dd>{p.deliverables.join(' · ')}</dd>
                </div>
                {p.role && (
                  <div>
                    <dt class="t-meta">Rôle</dt>
                    <dd>{p.role}</dd>
                  </div>
                )}
              </dl>
              <p class="work__foot" data-reveal style="--i: 4">
                <span class="tag">{p.selection}</span>
                {p.prototype && (
                  <a class="link t-meta t-meta--fg" href={p.prototype.href} target="_blank" rel="noopener">
                    {p.prototype.label} <span class="arrow arrow--ne" aria-hidden="true">↗</span>
                    <span class="sr-only">— {p.title} (ouvre un nouvel onglet)</span>
                  </a>
                )}
                <a class="link t-meta t-meta--fg work__more" href={href(`projets/${p.slug}/`)} data-astro-prefetch>
                  Lire l’étude <span class="sr-only">{p.client} — {p.title}</span>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container" aria-labelledby="index-title">
    <SectionHead index="+" label="Index" id="index-title" title="Tous les projets" />
    <ProjectIndex headingLevel="h3" />
  </section>
</Base>

<script>
  // Filtre par lecture : masque les études hors sélection, sans recharger la page.
  document.querySelectorAll<HTMLElement>('[data-filter]').forEach((group) => {
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-filter-value]'));
    const items = Array.from(document.querySelectorAll<HTMLElement>('.work[data-selection]'));
    const apply = (value: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filterValue === value)));
      items.forEach((item) => {
        item.hidden = value !== 'all' && item.dataset.selection !== value;
        item.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in'));
      });
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filterValue ?? 'all')));
    const initial = new URLSearchParams(location.search).get('lecture');
    if (initial && buttons.some((b) => b.dataset.filterValue === initial)) apply(initial);
  });
</script>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding-bottom: var(--space-l);
  }

  .filter__btn {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    font-weight: 500;
    transition:
      background var(--dur-2) var(--ease-out),
      color var(--dur-2);
  }

  .filter__btn[aria-pressed='true'] {
    background: var(--fg);
    color: var(--bg);
  }

  .filter__n {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    opacity: 0.7;
  }

  .work__facts {
    display: grid;
    gap: var(--space-2xs);
    padding-top: var(--space-xs);
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
  }

  .work__facts > div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-xs);
    align-items: baseline;
  }

  .work__facts dd {
    color: var(--fg-muted);
  }

  .works__list {
    display: grid;
    gap: var(--space-2xl);
  }

  .work {
    display: grid;
    gap: var(--space-m) var(--col-gap);
    align-items: center;
    padding-top: var(--space-l);
    border-top: 1px solid var(--border);
  }

  @media (min-width: 1024px) {
    .work {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .work__media {
      grid-column: 1 / 8;
    }

    .work__text {
      grid-column: 9 / -1;
    }

    .work--reverse .work__media {
      grid-column: 6 / -1;
      grid-row: 1;
    }

    .work--reverse .work__text {
      grid-column: 1 / 5;
      grid-row: 1;
    }
  }

  .work__media {
    display: block;
    aspect-ratio: 16 / 10;
  }

  .work__media :global(img) {
    transition: transform 1.2s var(--ease-out);
  }

  .work:has(a:hover) .work__media :global(img) {
    transform: scale(1.035);
  }

  .work__text {
    display: grid;
    gap: var(--space-s);
  }

  .work__meta {
    display: flex;
    gap: var(--space-s);
  }

  .work__year {
    margin-left: auto;
  }

  .work__title {
    font-size: var(--step-4);
    font-weight: 600;
    font-stretch: 80%;
    letter-spacing: var(--tracking-display);
    line-height: 0.95;
  }

  .work__link {
    background-image: linear-gradient(var(--c-signal), var(--c-signal));
    background-repeat: no-repeat;
    background-size: 0% 0.06em;
    background-position: 0 92%;
    transition: background-size var(--dur-3) var(--ease-out);
  }

  .work__link:hover,
  .work__link:focus-visible {
    background-size: 100% 0.06em;
  }

  .work:has(a:hover) .work__more .arrow {
    transform: translateX(0.25em);
  }

  .work__q {
    font-size: var(--step-2);
    line-height: 1.15;
  }

  .work__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-top: var(--space-s);
  }
</style>
