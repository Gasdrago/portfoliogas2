---
/**
 * Page Projets : un index simple. Une ligne par projet, filtrable par lecture.
 * Sur grand écran, le visuel du projet survolé suit le curseur ; sur téléphone, il est dans la ligne.
 */
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHead from '@/components/PageHead.astro';
import { projects, selections } from '@/data/projects';
import { href } from '@/lib/url';

const lectureId = (name: string) => selections.find((sel) => sel.name === name)?.id ?? '';
---

<Base
  title="Projets"
  description="Six études de cas de Gaspard Bayle, en deux lectures : conseil & innovation (La Poste, EvoBIM, INRAE) et produit & prototype (Main levée, Sun Scan, Comp-AI-gnons)."
>
  <PageHead kicker="(Projets) Index" lines={['Six projets,', 'du terrain à la preuve.']} serifLine={1}>
    <p>
      Chaque étude dit ce qui a été cherché, ce qui a été produit et ce qui le prouve. Filtrez par lecture,
      ou ouvrez directement un projet.
    </p>
  </PageHead>

  <section class="container idx" aria-label="Liste des projets" data-index>
    <div class="idx__bar">
      <div class="filter" role="group" aria-label="Filtrer par lecture" data-filter>
        <button class="filter__btn" type="button" aria-pressed="true" data-filter-value="all">
          Tous <span class="filter__n">{projects.length}</span>
        </button>
        {
          selections.map((sel) => (
            <button class="filter__btn" type="button" aria-pressed="false" data-filter-value={sel.id}>
              {sel.name} <span class="filter__n">{projects.filter((p) => p.selection === sel.name).length}</span>
            </button>
          ))
        }
      </div>
      <p class="idx__cols t-meta" aria-hidden="true">
        <span>N°</span>
        <span>Projet</span>
        <span>Discipline</span>
        <span>Lecture</span>
        <span>Année</span>
      </p>
    </div>

    <ol role="list" class="idx__list">
      {
        projects.map((p, i) => (
          <li class="row" data-selection={lectureId(p.selection)} data-reveal style={`--i: ${i}`}>
            <a class="row__link" href={href(`projets/${p.slug}/`)} data-preview={p.slug} data-astro-prefetch>
              <span class="row__n t-index">{p.index}</span>
              <span class="row__thumb" aria-hidden="true">
                <Image
                  src={p.thumb}
                  alt=""
                  widths={[160, 320]}
                  width={320}
                  sizes="5.5rem"
                  format="webp"
                  quality={78}
                  loading="lazy"
                />
              </span>
              <span class="row__main">
                <span class="row__title">{p.title}</span>
                <span class="row__client t-serif">{p.client}</span>
                <span class="row__proof">{p.proof}</span>
              </span>
              <span class="row__disc">{p.discipline}</span>
              <span class="row__lecture">{p.selection}</span>
              <span class="row__year t-meta">{p.year}</span>
              <span class="row__arrow arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="idx__empty t-meta" hidden data-empty>Aucun projet dans cette lecture.</p>

    <!-- Aperçu qui suit le curseur (grand écran, souris) -->
    <div class="pv" aria-hidden="true" data-pv>
      {
        projects.map((p) => (
          <div class="pv__item" data-pv-item={p.slug}>
            <Image
              src={p.cover}
              alt=""
              widths={[480, 768]}
              width={768}
              sizes="26rem"
              format="webp"
              quality={78}
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
  </section>
</Base>

<script>
  // Filtre par lecture : masque les projets hors sélection, sans recharger la page.
  document.querySelectorAll<HTMLElement>('[data-filter]').forEach((group) => {
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-filter-value]'));
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.row[data-selection]'));
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    const apply = (value: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filterValue === value)));
      let shown = 0;
      rows.forEach((row) => {
        row.hidden = value !== 'all' && row.dataset.selection !== value;
        if (!row.hidden) shown++;
        row.classList.add('is-in');
      });
      if (empty) empty.hidden = shown > 0;
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filterValue ?? 'all')));
    const initial = new URLSearchParams(location.search).get('lecture');
    if (initial && buttons.some((b) => b.dataset.filterValue === initial)) apply(initial);
  });

  // Aperçu au survol : seulement avec une souris, sur grand écran.
  const pv = document.querySelector<HTMLElement>('[data-pv]');
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1024px)');
  if (pv && canHover.matches) {
    const items = new Map(
      Array.from(pv.querySelectorAll<HTMLElement>('[data-pv-item]')).map((el) => [el.dataset.pvItem, el]),
    );
    // Les visuels sont chargés dès qu'on approche de la liste.
    pv.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let x = 0;
    let y = 0;
    let cx = 0;
    let cy = 0;
    let raf = 0;
    const loop = () => {
      cx += (x - cx) * (reduced ? 1 : 0.18);
      cy += (y - cy) * (reduced ? 1 : 0.18);
      pv.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
      raf = Math.abs(x - cx) + Math.abs(y - cy) > 0.5 ? requestAnimationFrame(loop) : 0;
    };
    document.querySelectorAll<HTMLAnchorElement>('[data-preview]').forEach((link) => {
      link.addEventListener('pointerenter', (e) => {
        items.forEach((el, key) => el.classList.toggle('is-active', key === link.dataset.preview));
        if (!pv.classList.contains('is-on')) {
          cx = x = e.clientX;
          cy = y = e.clientY;
          loop();
        }
        pv.classList.add('is-on');
      });
      link.addEventListener('pointerleave', () => pv.classList.remove('is-on'));
      link.addEventListener('pointermove', (e) => {
        x = e.clientX;
        y = e.clientY;
        if (!raf) raf = requestAnimationFrame(loop);
      });
    });
  }
</script>

<style>
  .idx {
    padding-bottom: var(--space-2xl);
  }

  /* ---- Barre : filtres et en-têtes de colonnes ------------------------- */
  .idx__bar {
    display: grid;
    gap: var(--space-m);
    padding-bottom: var(--space-xs);
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .filter__btn {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    font-weight: 500;
    transition:
      background var(--dur-2) var(--ease-out),
      color var(--dur-2);
  }

  .filter__btn[aria-pressed='true'] {
    background: var(--fg);
    color: var(--bg);
  }

  .filter__n {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    opacity: 0.7;
  }

  .idx__cols {
    display: none;
  }

  /* ---- Lignes ---------------------------------------------------------- */
  .idx__list {
    border-bottom: 1px solid var(--border-strong);
  }

  .row__link {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    grid-template-areas:
      'thumb main year'
      'thumb main arrow';
    gap: 0.15rem var(--space-s);
    align-items: start;
    padding-block: var(--space-s);
    border-top: 1px solid var(--border-strong);
    color: inherit;
    text-decoration: none;
  }

  .row__n,
  .row__disc,
  .row__lecture {
    display: none;
  }

  .row__thumb {
    grid-area: thumb;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-raised);
  }

  .row__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .row__main {
    grid-area: main;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .row__title {
    font-size: var(--step-2);
    font-weight: 600;
    font-stretch: 80%;
    line-height: 0.98;
    letter-spacing: var(--tracking-display);
    transition: color var(--dur-2);
  }

  .row__client {
    font-size: var(--step-0);
    color: var(--fg-muted);
  }

  .row__proof {
    color: var(--fg-subtle);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .row__year {
    grid-area: year;
    justify-self: end;
  }

  .row__arrow {
    grid-area: arrow;
    align-self: end;
    justify-self: end;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .row__link:hover .row__title,
  .row__link:focus-visible .row__title {
    color: var(--accent-text);
  }

  .row__link:hover .row__arrow,
  .row__link:focus-visible .row__arrow {
    transform: translateX(0.3em);
  }

  .idx__empty {
    padding-top: var(--space-m);
  }

  /* ---- Grand écran : un vrai index en colonnes ------------------------- */
  @media (min-width: 1024px) {
    .idx__bar {
      grid-template-columns: 1fr;
    }

    .idx__cols,
    .row__link {
      display: grid;
      grid-template-columns: 3.5rem minmax(0, 1fr) 13rem 11rem 4rem 1.5rem;
      grid-template-areas: none;
      gap: var(--col-gap);
      align-items: baseline;
    }

    .idx__cols {
      padding-top: var(--space-m);
      color: var(--fg-subtle);
    }

    .row__link {
      padding-block: var(--space-m);
    }

    .row__n,
    .row__disc,
    .row__lecture {
      display: block;
    }

    .row__thumb {
      display: none;
    }

    .row__main {
      grid-area: auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem var(--space-s);
    }

    .row__title {
      font-size: clamp(2rem, 0.6rem + 3vw, 3.75rem);
    }

    .row__client {
      font-size: var(--step-1);
    }

    .row__proof {
      flex-basis: 100%;
      font-size: var(--step-0);
    }

    .row__disc,
    .row__lecture {
      color: var(--fg-muted);
      font-size: var(--step--1);
      line-height: 1.35;
    }

    .row__year,
    .row__arrow {
      grid-area: auto;
    }

    .row__arrow {
      align-self: baseline;
    }

    /* Les autres lignes s'effacent quand on en survole une. */
    .idx__list:has(.row__link:hover) .row__link:not(:hover) {
      opacity: 0.35;
    }

    .row__link {
      transition: opacity var(--dur-2);
    }
  }

  /* ---- Aperçu flottant ------------------------------------------------- */
  .pv {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 5;
    width: 26rem;
    aspect-ratio: 16 / 10;
    pointer-events: none;
    display: none;
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) {
    .pv {
      display: block;
      margin: 1.5rem 0 0 1.5rem;
      opacity: 0;
      transition: opacity var(--dur-2);
    }

    .pv.is-on {
      opacity: 1;
    }
  }

  .pv__item {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.18);
  }

  .pv__item.is-active {
    opacity: 1;
  }

  .pv__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
