                <th scope="row">{cond}</th>
                <td>{then}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </CaseSection>

  <!-- 17 — Test --------------------------------------------------------- -->
  <CaseSection index="17" label="Faisabilité" title="Faisable, testable, réfutable." layout="full" id="test">
    <Numbered
      items={[
        { title: 'A · Immédiate', text: 'Sonnerie et fenêtre, comme aujourd’hui.' },
        { title: 'B · Médiée', text: 'Retard automatique, sans signal.' },
        { title: 'C · Main levée', text: 'Retenue visible, parole donnée.' },
      ]}
    />
    <div class="split">
      <div class="stack-s" data-reveal>
        <p class="t-meta">Protocole</p>
        <p class="t-body">
          Trois conditions, les mêmes sollicitations, sur simulateur, avec douze à quinze participants.
          Mesures : moment choisi, regards hors de la route et vers la lueur, tenue de trajectoire,
          sentiment de maîtrise. Matériel : ruban de LED, trois boutons, voix jouée par
          l’expérimentateur ; aucune caméra requise.
        </p>
      </div>
      <div class="stack-s" data-reveal style="--i: 1">
        <p class="t-meta">Critère d’échec</p>
        <p class="t-body">
          La lueur attire des regards répétés, ou les participants se sentent pressés de répondre.
        </p>
        <p class="t-meta">Prochaines étapes</p>
        <ol role="list" class="next-steps">
          <li>Prototyper la lueur et les trois touches.</li>
          <li>Tester les trois conditions sur simulateur.</li>
          <li>Revoir le signal selon les regards mesurés.</li>
        </ol>
      </div>
    </div>
    <p class="note" data-reveal>Rien n’est encore testé : tous les bénéfices décrits sont des hypothèses.</p>
  </CaseSection>

