---
import CaseStudy from '@/layouts/CaseStudy.astro';
import CaseSection from '@/components/case/CaseSection.astro';
import Numbered from '@/components/case/Numbered.astro';
import Statement from '@/components/case/Statement.astro';
import BarChart from '@/components/case/BarChart.astro';
import Annotated from '@/components/case/Annotated.astro';
import Cards from '@/components/case/Cards.astro';
import Video from '@/components/case/Video.astro';
import Figure from '@/components/Figure.astro';
import { decks, slide, getProject } from '@/data/projects';
import volant from '@/assets/crops/renault-volant.jpg';
import poster from '@/assets/crops/main-levee-poster.jpg';
import habitacleEtats from '@/assets/projects/renault-copilote/habitacle-etats.png';
import volantDetails from '@/assets/projects/renault-copilote/volant-details.png';
import compagnon from '@/assets/projects/renault-copilote/compagnon.png';
import role from '@/assets/projects/renault-copilote/role.jpg';
import supportBoule from '@/assets/projects/renault-copilote/support-boule.jpg';
import supportEcran from '@/assets/projects/renault-copilote/support-ecran.jpg';
import supportVolant from '@/assets/projects/renault-copilote/support-volant.jpg';
import objetFace from '@/assets/projects/renault-copilote/objet-face.jpg';
import objetProfil from '@/assets/projects/renault-copilote/objet-profil.jpg';
import themeCompagnon from '@/assets/projects/renault-copilote/theme-compagnon.jpg';
import themeOnde from '@/assets/projects/renault-copilote/theme-onde.jpg';
import themeMinimal from '@/assets/projects/renault-copilote/theme-minimal.jpg';
import themeBague from '@/assets/projects/renault-copilote/theme-bague.jpg';
import etats from '@/assets/projects/renault-copilote/etats.jpg';
import sc1 from '@/assets/projects/renault-copilote/sc1.jpg';
import sc2 from '@/assets/projects/renault-copilote/sc2.jpg';
import sc3 from '@/assets/projects/renault-copilote/sc3.jpg';
import sc4 from '@/assets/projects/renault-copilote/sc4.jpg';
import fRecharge from '@/assets/projects/renault-copilote/f-recharge.jpg';
import fAppel from '@/assets/projects/renault-copilote/f-appel.jpg';
import fIndispo from '@/assets/projects/renault-copilote/f-indispo.jpg';

const project = getProject('renault-center-view');
const s = (n: number) => slide(decks.renault, n);
const lb = 'renault';

// Trois supports, trois rôles.
const supports = [
  {
    image: supportBoule,
    alt: 'Gros plan sur la boule : un visage lumineux de deux yeux et un arc, derrière le verre fumé.',
    kicker: 'La boule',
    title: 'L’état et l’intention',
    text: 'Un signe simple : je veille, j’écoute, je prépare, je propose.',
  },
  {
    image: supportEcran,
    alt: 'L’écran central propose « Éviter la zone encombrée ? » avec le temps ajouté, l’heure d’arrivée et le tracé du détour.',
    kicker: 'L’écran central',
    title: 'Les options et leurs conséquences',
    text: 'Le trajet, le temps ajouté, la raison de la proposition.',
  },
  {
    image: supportVolant,
    alt: 'Les touches Oui (coche) et Non (croix) sur la branche droite du volant.',
    kicker: 'La voix et le volant',
    title: 'La décision',
    text: 'Parole ouvre ou interrompt. Oui accepte. Non refuse.',
  },
];

const themes = [
  { image: themeCompagnon, name: 'Compagnon', text: 'Deux yeux, un arc.' },
  { image: themeOnde, name: 'Onde', text: 'Une courbe.' },
  { image: themeMinimal, name: 'Minimal', text: 'Un trait.' },
];

const scenario = [
  { image: sc1, step: 'Signal', text: 'Une proposition est prête. Le copilote attend.' },
  { image: sc2, step: 'Parole', text: 'J’appuie sur Parole et je dis ma préférence.' },
  { image: sc3, step: 'Proposition', text: 'Éviter la zone encombrée : +3 min, arrivée 18:45.' },
  { image: sc4, step: 'Décision', text: 'Oui au volant. Le trajet est mis à jour.' },
];

const functions = [
  {
    image: fRecharge,
    title: 'Préparer une recharge',
    text: 'Une estimation, affichée comme telle. Pas de disponibilité de borne inventée.',
    alt: 'Le copilote affiche un éclair et l’écran propose « Une pause recharge sur le trajet ? ».',
  },
  {
    image: fAppel,
    title: 'Différer un appel',
    text: 'Ni rappel ni message sans mon autorisation.',
    alt: 'Le copilote affiche un combiné et l’écran propose « Rappeler Camille à l’arrivée ? ».',
  },
  {
    image: fIndispo,
    title: 'Indisponible',
    text: 'Le copilote le dit. Les commandes du véhicule restent actives.',
    alt: 'La boule en état indisponible, l’écran indique « Copilote indisponible ».',
  },
];

const sources = [
  ['Renault, reno, l’avatar officiel', 'https://www.renault.fr/vehicules-electriques/r4-e-tech-electrique/virtual-assistant-reno.html'],
  ['Automotive World, Gemini dans openR link · juin 2026', 'https://www.automotiveworld.com/news/google-gemini-rolls-out-across-renaults-vehicle-fleet/'],
  ['Google, Gemini dans les voitures Google built-in · avril 2026', 'https://blog.google/products/android/cars-with-google-built-in-gemini-tips-2026'],
  ['eWeek, MBUX Virtual Assistant · janvier 2025', 'https://www.eweek.com/news/mercedes-gemini-ai-navigation'],
  ['BMW Group, iX3 au CES 2026', 'https://press.bmwgroup.com/usa/article/detail/T0454794EN_US/the-bmw-ix3-ushers-in-next-generation-innovations-at-ces-2026'],
  ['Bosch, AI-powered cockpit · janvier 2026', 'https://www.bosch-presse.de/pressportal/us/en/image-31172.html'],
  ['S&P Global, entretien avec Cerence AI · janvier 2026', 'https://autotechinsight.spglobal.com/news/5285942/a-conversation-with-cerence-ai-at-ces'],
  ['Volkswagen, Hello ID. Light', 'https://volkswagen-newsroom.com/en/stories/hello-id-light-how-the-new-id-models-communicate-with-the-vehicle-occupants-via-a-light-strip-6963'],
  ['Euro NCAP, protocoles 2026', 'https://www.euroncap.com/en/press-media/press-releases/euro-ncap-announces-2026-protocol-changes-to-tackle-modern-driving-risks'],
  ['Smart Eye, ADDW obligatoire · juillet 2026', 'https://smarteye.se/news/advanced-driver-distraction-warning-systems-now-mandatory-across-all-new-eu-vehicles/'],
  ['McFarlane, coordination de l’interruption · 2002', 'https://doi.org/10.1207/s15327051hci1701_2'],
  ['Drews, Pasupathi et Strayer, passager et téléphone · 2008', 'https://www.apa.org/news/press/releases/2008/12/phone-driving'],
  ['Kim et al., moments opportuns en conduite · 2018', 'https://doi.org/10.1145/3287053'],
  ['Du et al., proactivité d’un assistant embarqué · 2024', 'https://arxiv.org/abs/2403.09135'],
  ['Flemisch et al., H-Mode · 2008', 'https://elib.dlr.de/57618/1/FISITA2008_DLR_FlemischEtAl_CooperativeControl.pdf'],
  ['Poly Haven, wide_street_01 · image d’environnement, licence CC0', 'https://polyhaven.com/a/wide_street_01'],
];
---

<CaseStudy slug={project.slug} surface="dark">
  <!-- En bref ---------------------------------------------------------- -->
  <section class="brief container" aria-labelledby="brief-title">
    <h2 id="brief-title" class="sr-only">Le projet en bref</h2>
    <dl class="brief__grid">
      <div class="brief__item" data-reveal>
        <dt class="t-meta"><span class="t-index">A</span> Constat</dt>
        <dd>
          Un tableau de bord surchargé, alors que 87&nbsp;% des usages tiennent en trois applications. Et
          l’IA générative arrive dans l’habitacle sans règles.
        </dd>
      </div>
      <div class="brief__item" data-reveal style="--i: 1">
        <dt class="t-meta"><span class="t-index">B</span> Question</dt>
        <dd class="t-serif brief__q">Comment une IA peut-elle proposer sans s’imposer, quand je conduis&nbsp;?</dd>
      </div>
      <div class="brief__item" data-reveal style="--i: 2">
        <dt class="t-meta"><span class="t-index">C</span> Réponse</dt>
        <dd>
          <strong>Main levée</strong> : une boule-copilote qui signale puis attend. L’écran explique, la voix
          et le volant décident.
        </dd>
      </div>
    </dl>
    <Video
      src="media/main-levee.mp4"
      poster={poster}
      alt="Film Main levée : la conductrice appuie sur Parole au volant, le copilote affiche « Je vous écoute », puis propose « Éviter la zone encombrée ? » ; elle valide d’un appui sur Oui et le trajet est mis à jour."
      caption="Film — le copilote propose, la conductrice décide"
    />
  </section>

  <!-- 01 — Point de départ ---------------------------------------------- -->
  <CaseSection index="01" label="Point de départ" title="Un habitacle saturé pour trois usages." layout="full" id="recherche">
    <div class="research">
      <div class="research__text">
        <p class="t-lead" data-reveal>
          Le brief était large : imaginer le futur de l’interaction de la mobilité. L’analyse de
          l’habitacle et l’enquête d’usage ont resserré le sujet.
        </p>
        <p class="kpi" data-reveal style="--i: 1">
          <span class="kpi__value">87&nbsp;%</span>
          <span class="kpi__label">des usages déclarés tiennent en trois applications : navigation, musique, communication.</span>
        </p>
        <ul role="list" class="tags" data-reveal style="--i: 2" aria-label="Problèmes relevés">
          {['Surinformation', 'Distraction visuelle', 'Interface peu intuitive'].map((t) => <li class="tag">{t}</li>)}
        </ul>
      </div>
      <div class="research__chart">
      <BarChart
        title="Applications les plus utilisées en voiture"
        highlight={3}
        data={[
          { label: 'Navigation', value: 43.5 },
          { label: 'Musique', value: 26.1 },
          { label: 'Communication', value: 17.4 },
          { label: 'Info-trafic', value: 8.7 },
          { label: 'Autre', value: 4.3 },
        ]}
        source="Données présentées dans le dossier de projet."
      />
      </div>
    </div>
    <div class="pair">
      <Figure
        src={s(3)}
        alt="Analyse de l’habitacle : photo du poste de conduite avec une carte de chaleur des zones les plus touchées (rouge) aux moins touchées (vert)."
        caption="Ce que l’on touche"
        sizes="(min-width: 768px) 50vw, 100vw"
        lightbox={lb}
      />
      <Figure
        src={s(4)}
        alt="Analyse de l’habitacle : carte de chaleur des zones les plus regardées, du bleu foncé au turquoise."
        caption="Ce que l’on regarde"
        sizes="(min-width: 768px) 50vw, 100vw"
        lightbox={lb}
        style="--i: 1"
      />
    </div>
  </CaseSection>

  <!-- 02 — Opportunité --------------------------------------------- -->
  <CaseSection index="02" label="Opportunité" title="L’IA entre dans l’habitacle." id="opportunite">
    <p class="t-lead case-lead" data-reveal>
      Épurer l’écran ne suffit plus : la voiture attend toujours l’ordre, et les assistants génératifs
      arrivent en série sans que rien ne leur fasse de place.
    </p>
    <Numbered
      items={[
        { title: 'Ils parlent', text: 'Ils suggèrent, anticipent, prennent l’initiative.' },
        { title: 'Ils interrompent', text: 'Chaque suggestion est une interruption, et on ne sait pas toujours d’où elle vient.' },
        { title: 'L’opportunité', text: 'Donner à l’IA un corps lisible et des règles de tour de parole.' },
      ]}
    />
  </CaseSection>

  <Statement kicker="Problématique" text="Comment une IA peut-elle proposer sans s’imposer, quand je conduis ?" />

  <!-- 03 — Solution ----------------------------------------------------- -->
  <section class="solution" data-theme="night" data-surface="dark" aria-labelledby="solution-title">
    <div class="container solution__head">
      <p class="t-meta" data-reveal><span class="t-index">03</span> Solution</p>
      <h2 id="solution-title" class="solution__title" data-lines>
        <span class="line"><span>Main levée</span></span>
      </h2>
      <div class="solution__intro">
        <p class="solution__tag t-serif" data-reveal style="--i: 2">
          Un copilote qui propose. Une conductrice qui décide.
        </p>
        <p class="t-lead" data-reveal style="--i: 3">
          Le copilote prend la forme d’une boule posée sur le bandeau de la planche de bord. Il prépare une
          proposition ; la conductrice l’accepte, la corrige ou la refuse.
        </p>
      </div>
    </div>
    <Figure
      src={habitacleEtats}
      alt="L’habitacle avec le copilote sur la planche de bord et un bandeau qui propose « Un trajet plus calme ? » (Accepter, Plus tard) ; en dessous, la boule en gros plan et ses états : veille, écoute, proposition."
      caption="L’habitacle et la boule : veille, écoute, proposition"
      sizes="100vw"
      class="bleed"
      lightbox={lb}
    />
  </section>

  <!-- 04 — Le rôle du copilote ------------------------------------------ -->
  <CaseSection index="04" label="Le rôle du copilote" title="Il prépare une proposition. Je l’accepte, je la corrige ou je la refuse." layout="full" id="role">
    <div class="split">
      <Figure
        src={role}
        alt="Le copilote affiche une bifurcation et l’écran propose « Éviter la zone encombrée ? » avec deux boutons."
        sizes="(min-width: 768px) 50vw, 100vw"
        lightbox={lb}
      />
      <div class="stack-s">
        <Numbered
          columns={1}
          items={[
            { title: 'Il part de ce que je lui ai dit, pas de ce qu’il devine de moi.' },
            { title: 'Il signale qu’il a quelque chose, puis il attend.' },
            { title: 'Sans réponse, rien ne change.' },
          ]}
        />
        <p class="t-meta" data-reveal>Aucune déduction certaine du stress ou de l’émotion. Aucune action de conduite.</p>
      </div>
    </div>
  </CaseSection>

  <!-- 05 — Qui fait quoi ------------------------------------------------ -->
  <CaseSection index="05" label="Qui fait quoi" title="Trois supports, trois rôles." layout="full" id="supports">
    <ul role="list" class="tiles">
      {
        supports.map((t, i) => (
          <li class="tile" data-reveal style={`--i: ${i}`}>
            <Figure src={t.image} alt={t.alt} ratio="16 / 9" sizes="(min-width: 768px) 33vw, 100vw" reveal={false} lightbox={lb} />
            <p class="t-meta tile__kicker">{t.kicker}</p>
            <h3 class="tile__title">{t.title}</h3>
            <p class="t-body">{t.text}</p>
          </li>
        ))
      }
    </ul>
  </CaseSection>

  <!-- 06 — L'objet ------------------------------------------------------ -->
  <CaseSection index="06" label="L’objet" title="Une boule de 9 cm, posée sur le bandeau en aluminium." layout="full" id="objet">
    <Annotated
      image={objetFace}
      alt="La boule de face, visage Compagnon, à côté de l’écran qui affiche « Bonjour »."
      lightbox={lb}
      notes={[
        { term: 'Verre fumé bombé', text: 'La surface d’affichage est derrière le verre.' },
        { term: 'Bague moletée et repère', text: 'À l’arrêt : tourner pour parcourir, presser pour choisir.' },
        { term: 'Fourche, pivots, butées', text: 'Une orientation légère vers la personne, bornée.' },
        { term: 'Embase', text: 'Grille et micros.' },
      ]}
    />
    <div class="pair">
      <Figure
        src={objetProfil}
        alt="La boule de profil : verre bombé, fourche et pivot à bague moletée."
        caption="Profil — fourche et pivot"
        sizes="(min-width: 768px) 50vw, 100vw"
        lightbox={lb}
      />
      <Figure
        src={volantDetails}
        alt="Le volant et ses commandes, l’intégration de la boule sur le bandeau en aluminium, et les matières : cuir surpiqué, aluminium brossé, filet lumineux."
        caption="Intégration, matières et finitions"
        sizes="(min-width: 768px) 50vw, 100vw"
        lightbox={lb}
      />
    </div>
    <p class="t-meta" data-reveal>Rendus Blender. Dimensions et mécanique : intentions de conception, non validées par un prototype physique.</p>
  </CaseSection>

  <!-- 07 — Personnalisation --------------------------------------------- -->
  <CaseSection index="07" label="Personnalisation · uniquement à l’arrêt" title="Trois apparences, une seule grammaire." layout="full" id="personnalisation">
    <ul role="list" class="themes">
      {
        themes.map((t, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <Figure src={t.image} alt={`La boule en apparence ${t.name} : ${t.text.toLowerCase()}`} ratio="1 / 1" sizes="(min-width: 768px) 25vw, 33vw" reveal={false} />
            <h3 class="tile__title">{t.name}</h3>
            <p class="t-body">{t.text}</p>
          </li>
        ))
      }
    </ul>
    <div class="split">
      <Figure
        src={themeBague}
        alt="À l’arrêt, l’écran de personnalisation montre les trois apparences ; la boule affiche l’aperçu de l’onde."
        caption="La bague parcourt les thèmes ; la boule montre l’aperçu tout de suite"
        sizes="(min-width: 768px) 50vw, 100vw"
        lightbox={lb}
      />
      <Figure
        src={compagnon}
        alt="Le copilote en apparence Compagnon : « Bonjour Mélina, où allons-nous ? » à l’écran ; vignettes écouter, proposer, se personnaliser à l’arrêt."
        caption="Une présence personnalisable"
        sizes="(min-width: 768px) 50vw, 100vw"
        lightbox={lb}
      />
    </div>
    <p class="t-meta" data-reveal>Les teintes sont limitées, et la signification des états reste identique d’un thème à l’autre.</p>
  </CaseSection>

  <!-- 08 — États -------------------------------------------------------- -->
  <CaseSection index="08" label="États et transitions" title="Neuf états, reconnaissables par la forme autant que par la couleur." layout="full" id="etats">
    <Figure
      src={etats}
      alt="Les neuf états de la boule, thème Compagnon : accueil, veille, proposition prête, écoute, préparation, proposition, confirmation, refus, indisponible."
      sizes="(min-width: 1680px) 1600px, 100vw"
      tone="none"
      lightbox={lb}
    />
    <Cards
      cards={[
        { title: 'En conduite', text: 'La veille est stable et très discrète.' },
        { title: 'Proposition prête', text: 'Une transition courte, puis un signal fixe. Pas de clignotement.' },
        { title: 'Refus', text: 'Retour au calme, sans déception simulée.' },
      ]}
    />
    <p class="t-meta" data-reveal>Rendus Blender, thème Compagnon. Les transitions durent quelques dixièmes de seconde.</p>
  </CaseSection>

  <!-- 09 — Scénario ----------------------------------------------------- -->
  <CaseSection index="09" label="Scénario principal · adapter un trajet" title="« Je préfère un trajet plus tranquille »" layout="full" id="scenario">
    <ol role="list" class="tiles tiles--4">
      {
        scenario.map((t, i) => (
          <li class="tile" data-reveal style={`--i: ${i}`}>
            <Figure src={t.image} alt={`Étape ${i + 1}, ${t.step.toLowerCase()} : ${t.text}`} ratio="16 / 9" sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw" reveal={false} lightbox={lb} />
            <p class="t-meta tile__kicker">{i + 1} · {t.step}</p>
            <p class="t-body">{t.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="t-lead" data-reveal>
      Données de navigation, préférence dite, calcul du copilote, décision de la conductrice : chaque
      source est nommée à l’écran.
    </p>
    <p class="t-meta" data-reveal>Images du film. Valeurs de démonstration ; comportement de l’IA scénarisé.</p>
  </CaseSection>

  <!-- 10 — Le volant ---------------------------------------------------- -->
  <CaseSection index="10" label="Le volant" title="Parole, Oui, Non : la décision reste au volant." layout="full" id="volant">
    <p class="t-lead" data-reveal>
      Parole ouvre l’échange ou interrompt le copilote à tout moment. Oui accepte, Non refuse. Le volant
      a été repensé pour décider sans lâcher la route des yeux.
    </p>
    <Annotated
      image={volant}
      alt="Rendu 3D du volant, vu de trois quarts, avec ses commandes intégrées."
      lightbox={lb}
      notes={[
        { term: 'Clignotant', text: 'Intégré directement aux branches du volant.' },
        { term: 'Flèches de sélection', text: 'Ces boutons ont plusieurs fonctionnalités en fonction du mode activé.' },
        { term: 'Bouton +/−', text: 'Ajuster, selon le mode actif.' },
        { term: 'Validation', text: 'Deux boutons, ✓ et ✗ : Oui et Non.' },
      ]}
    />
    <div class="trio">
      <Figure src={s(31)} alt="Détail du volant : clignotant, flèches de sélection et bouton plus/moins." caption="Commandes gauche" sizes="(min-width: 768px) 33vw, 100vw" lightbox={lb} />
      <Figure src={s(32)} alt="Détail du volant : clignotant et boutons de validation." caption="Commandes droite" sizes="(min-width: 768px) 33vw, 100vw" lightbox={lb} />
      <Figure src={s(30)} alt="Pictogrammes des boutons : croix, coche et flèches." caption="Design des boutons" sizes="(min-width: 768px) 33vw, 100vw" lightbox={lb} />
    </div>
  </CaseSection>

  <!-- 11 — Fonctions complémentaires ----------------------------------- -->
  <CaseSection index="11" label="Fonctions complémentaires et reprise en main" title="La même logique pour la recharge, l’appel et la panne." layout="full" id="fonctions">
    <ul role="list" class="tiles">
      {
        functions.map((t, i) => (
          <li class="tile" data-reveal style={`--i: ${i}`}>
            <Figure src={t.image} alt={t.alt} ratio="16 / 9" sizes="(min-width: 768px) 33vw, 100vw" reveal={false} lightbox={lb} />
            <h3 class="tile__title">{t.title}</h3>
            <p class="t-body">{t.text}</p>
          </li>
        ))
      }
    </ul>
    <p class="t-meta" data-reveal>Parole interrompt à tout moment. Un appui long sur Non suspend les propositions non essentielles.</p>
  </CaseSection>

  <!-- 12 — Prototype et limites ---------------------------------------- -->
  <CaseSection index="12" label="Prototype, faisabilité, limites" title="Ce qui existe, ce qui reste une hypothèse." layout="full" id="limites">
    <Cards
      cards={[
        {
          title: 'Réalisé',
          items: ['Maquette 3D de l’habitacle et de la boule dans Blender', 'Écrans animés en calques éditables', 'Film de 45 s et version courte'],
        },
        {
          title: 'Hypothèses',
          items: ['Lisibilité de la boule en plein soleil', 'Retour haptique des touches', 'Orientation motorisée, bruit et tenue aux chocs'],
        },
        {
          title: 'À tester',
          items: [
            'Comprend-on les neuf états sans explication ?',
            'Le signal fixe est-il remarqué sans détourner le regard ?',
            'Un visage aide-t-il, ou gêne-t-il ?',
          ],
        },
      ]}
    />
    <p class="note" data-reveal>
      Aucun test utilisateur n’a été mené. Le comportement de l’IA est scénarisé : ce n’est pas un
      assistant embarqué fonctionnel, ni un produit Renault.
    </p>
  </CaseSection>

  <!-- Synthèse ---------------------------------------------------------- -->
  <section class="synthese container" aria-labelledby="synthese-title">
    <p class="t-meta" data-reveal>Synthèse</p>
    <h2 id="synthese-title" class="synthese__title t-serif" data-reveal style="--i: 1">
      Une présence, trois rôles, un dernier mot.
    </h2>
    <ul role="list" class="synthese__list">
      {
