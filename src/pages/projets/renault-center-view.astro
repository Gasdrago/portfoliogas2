---
import CaseStudy from '@/layouts/CaseStudy.astro';
import CaseSection from '@/components/case/CaseSection.astro';
import Quotes from '@/components/case/Quotes.astro';
import Numbered from '@/components/case/Numbered.astro';
import Statement from '@/components/case/Statement.astro';
import BarChart from '@/components/case/BarChart.astro';
import Annotated from '@/components/case/Annotated.astro';
import Cards from '@/components/case/Cards.astro';
import Video from '@/components/case/Video.astro';
import Figure from '@/components/Figure.astro';
import { decks, slide, getProject } from '@/data/projects';
import volant from '@/assets/crops/renault-volant.jpg';
import poster from '@/assets/crops/main-levee-poster.jpg';
import habitacleEtats from '@/assets/projects/renault-copilote/habitacle-etats.png';
import volantDetails from '@/assets/projects/renault-copilote/volant-details.png';
import jeVousEcoute from '@/assets/projects/renault-copilote/je-vous-ecoute.png';
import compagnon from '@/assets/projects/renault-copilote/compagnon.png';

const project = getProject('renault-center-view');
const s = (n: number) => slide(decks.renault, n);
const lb = 'renault';

// Benchmark 2025–2026 — grille de McFarlane (2002) : qui décide du moment de l'interruption.
const modes = [
  { mode: 'Sur demande', what: 'On appelle l’IA', refs: 'reno, Gemini, MBUX, BMW avec Alexa+' },
  { mode: 'Immédiate', what: 'Elle parle tout de suite', refs: 'Sonnerie, fenêtre, ID. Light, suggestions' },
  { mode: 'Médiée', what: 'Le système choisit le moment', refs: 'Volvo IDIS, 2003 : invisible' },
  { mode: 'Planifiée', what: 'À des moments convenus', refs: 'Routines, bilans à l’arrivée' },
  { mode: 'Négociée', what: 'L’IA signale, la personne choisit quand', refs: 'Aucune référence de série trouvée' },
];

const references = [
  ['Renault reno et Gemini dans openR link', '2024–2026, en série', 'Avatar et assistant conversationnel, activés à la voix', 'Répond quand on l’appelle ; rien sur le moment'],
  ['Mercedes MBUX, BMW avec Alexa+', '2025–2026, en série ou annoncé', 'Dialogue libre, mémoire, suggestions selon les habitudes', 'Plus de parole, pas de tour de parole'],
  ['Cockpits IA de Bosch et Cerence', 'Janvier 2026, démonstrateurs', 'Anticipent à partir des routines et du contexte', 'Plus d’initiative côté machine, sans borne visible'],
  ['Volvo IDIS', '2003, en série', 'Retarde appels et informations pendant une manœuvre', 'Invisible, quelques secondes, décidé par le système'],
  ['Volkswagen ID. Light', '2020, en série', 'Bandeau lumineux sous le pare-brise : navigation, appel, alerte', 'Signale tout de suite ; ne retient rien'],
];

// Notes sur 5 par critère : un jugement de conception, pas une mesure.
const criteria = ['Utilité', 'Différenciation', 'Simplicité', 'Maîtrise laissée', 'Faisabilité', 'Démonstration'];
const pistes = [
  {
    n: '1',
    name: 'Main levée',
    total: 27,
    retained: true,
    text: 'L’IA lève la main. La conductrice lui donne la parole d’un appui au volant.',
    control: 'À chaque événement',
    note: 'Proche d’IDIS et d’ID. Light, mais la retenue se voit et la conductrice juge.',
  },
  {
    n: '2',
    name: 'La Rêne',
    total: 20,
    text: 'Une bague crantée règle la liberté laissée à l’IA : courte, moyenne ou longue.',
    control: 'En continu',
    note: 'Proche du H-Mode. Risque : ne plus savoir sur quel cran on se trouve.',
  },
  {
    n: '3',
    name: 'Mandat',
    total: 15,
    text: 'On confie des missions avant de partir. L’IA agit et rend compte à l’arrêt.',
    control: 'À l’avance',
    note: 'Proche des agents actuels. Risque : une erreur découverte trop tard.',
  },
];

const errors = [
  ['retient quelque chose d’urgent', 'La retenue reste visible ; deux appels rapprochés la rendent pressante ; liste « toujours immédiat ».'],
  ['lève la main au mauvais moment', 'Une lueur, sans son ni texte : il suffit de l’ignorer.'],
  ['manque de données ou de réseau', 'Elle le dit et propose le minimum ; les fonctions locales continuent.'],
  ['tombe en panne', 'Retour au mode direct, affiché : les appels sonnent.'],
];

const sources = [
  ['Renault, reno, l’avatar officiel', 'https://www.renault.fr/vehicules-electriques/r4-e-tech-electrique/virtual-assistant-reno.html'],
  ['Automotive World, Gemini dans openR link · juin 2026', 'https://www.automotiveworld.com/news/google-gemini-rolls-out-across-renaults-vehicle-fleet/'],
  ['Google, Gemini dans les voitures Google built-in · avril 2026', 'https://blog.google/products/android/cars-with-google-built-in-gemini-tips-2026'],
  ['eWeek, MBUX Virtual Assistant · janvier 2025', 'https://www.eweek.com/news/mercedes-gemini-ai-navigation'],
  ['BMW Group, iX3 au CES 2026', 'https://press.bmwgroup.com/usa/article/detail/T0454794EN_US/the-bmw-ix3-ushers-in-next-generation-innovations-at-ces-2026'],
  ['Bosch, AI-powered cockpit · janvier 2026', 'https://www.bosch-presse.de/pressportal/us/en/image-31172.html'],
  ['S&P Global, entretien avec Cerence AI · janvier 2026', 'https://autotechinsight.spglobal.com/news/5285942/a-conversation-with-cerence-ai-at-ces'],
  ['Volvo Cars, IDIS · octobre 2003', 'https://mb.cision.com/Main/23622/4199850/3566303.pdf'],
  ['Volkswagen, Hello ID. Light', 'https://volkswagen-newsroom.com/en/stories/hello-id-light-how-the-new-id-models-communicate-with-the-vehicle-occupants-via-a-light-strip-6963'],
  ['Euro NCAP, protocoles 2026', 'https://www.euroncap.com/en/press-media/press-releases/euro-ncap-announces-2026-protocol-changes-to-tackle-modern-driving-risks'],
  ['Smart Eye, ADDW obligatoire · juillet 2026', 'https://smarteye.se/news/advanced-driver-distraction-warning-systems-now-mandatory-across-all-new-eu-vehicles/'],
  ['McFarlane, coordination de l’interruption · 2002', 'https://doi.org/10.1207/s15327051hci1701_2'],
  ['Drews, Pasupathi et Strayer, passager et téléphone · 2008', 'https://www.apa.org/news/press/releases/2008/12/phone-driving'],
  ['Kim et al., moments opportuns en conduite · 2018', 'https://doi.org/10.1145/3287053'],
  ['Semmens et al., Is now a good time? · 2019', 'https://doi.org/10.1145/3290605.3300867'],
  ['Du et al., proactivité d’un assistant embarqué · 2024', 'https://arxiv.org/abs/2403.09135'],
  ['Flemisch et al., H-Mode · 2008', 'https://elib.dlr.de/57618/1/FISITA2008_DLR_FlemischEtAl_CooperativeControl.pdf'],
  ['BMW, Symbiotic Drive', 'https://www.bmwusa.com/technology-and-innovation/bmw-symbiotic-drive.html'],
];
---

<CaseStudy slug={project.slug} surface="dark">
  <!-- 01 — Contexte ---------------------------------------------------- -->
  <CaseSection index="01" label="Contexte" title="Un sujet ouvert, un habitacle saturé." id="contexte">
    <p class="t-lead case-lead" data-reveal>
      Le point de départ était volontairement large : imaginer le futur de l’interaction de la
      mobilité. Nous sommes partis de l’existant — le tableau de bord, ses écrans, ses boutons — et
      de celles et ceux qui l’utilisent au quotidien.
    </p>
    <div class="tasks" data-reveal style="--i: 1">
      <p class="t-meta">Missions</p>
      <ul role="list">
        {project.tasks.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </CaseSection>

  <!-- 02 — Recherche : habitacle --------------------------------------- -->
  <CaseSection index="02" label="Recherche" title="Ce que l’on touche, ce que l’on regarde." layout="full" id="recherche">
    <div class="pair">
      <Figure
        src={s(3)}
        alt="Analyse de l’habitacle : photo du poste de conduite avec une carte de chaleur des zones les plus touchées (rouge) aux moins touchées (vert)."
        caption="Zones les plus touchées"
        sizes="(min-width: 768px) 50vw, 100vw"
        lightbox={lb}
      />
      <Figure
        src={s(4)}
        alt="Analyse de l’habitacle : carte de chaleur des zones les plus regardées, du bleu foncé au turquoise."
        caption="Zones les plus regardées"
        sizes="(min-width: 768px) 50vw, 100vw"
        lightbox={lb}
        style="--i: 1"
      />
    </div>
  </CaseSection>

  <!-- 03 — Entretiens --------------------------------------------------- -->
  <CaseSection index="03" label="Entretiens" title="La parole des conducteurs." id="entretiens">
    <Quotes
      quotes={[
        { text: 'L’écran n’est pas assez utilisé' },
        { text: 'Certains boutons sont peu utiles' },
        { text: 'J’utilise juste le GPS et Spotify' },
        { text: 'Je ne sais pas à quoi ça sert' },
        { text: 'L’interface est trop chargée' },
      ]}
      source="Verbatims recueillis en entretien"
    />
  </CaseSection>

  <!-- 04 — Données ------------------------------------------------------ -->
  <CaseSection index="04" label="Usages" title="Trois applications concentrent l’essentiel." id="usages">
    <p class="kpi" data-reveal>
      <span class="kpi__value">87&nbsp;%</span>
      <span class="kpi__label">des usages déclarés tiennent en trois applications : navigation, musique, communication.</span>
    </p>
    <BarChart
      title="Applications les plus utilisées en voiture"
      highlight={3}
      data={[
        { label: 'Navigation', value: 43.5 },
        { label: 'Musique', value: 26.1 },
        { label: 'Communication', value: 17.4 },
        { label: 'Info-trafic', value: 8.7 },
        { label: 'Autre', value: 4.3 },
      ]}
    />
    <div class="charts-2">
      <BarChart
        title="Navigation — destinations"
        highlight={1}
        data={[
          { label: 'Adresse', value: 34.2 },
          { label: 'Travail', value: 26.3 },
          { label: 'Domicile', value: 21.1 },
          { label: 'Station essence', value: 10.5 },
          { label: 'Autre', value: 7.9 },
        ]}
      />
      <BarChart
        title="Communication — contacts"
        highlight={1}
        data={[
          { label: 'Famille', value: 48.4 },
          { label: 'Ami', value: 32.3 },
          { label: 'Un collègue', value: 12.9 },
          { label: 'Autre', value: 6.5 },
        ]}
      />
    </div>
    <p class="t-meta">Données présentées dans le dossier de projet.</p>
  </CaseSection>

  <!-- 05 — Problèmes ---------------------------------------------------- -->
  <CaseSection index="05" label="Problèmes" title="Trop d’informations, au mauvais moment." id="problemes">
    <Numbered
      size="l"
      columns={1}
      items={[
        { title: 'Surinformation' },
        { title: 'Distraction visuelle' },
        { title: 'Interface pas assez intuitive' },
        {
          title: 'Un mauvais moment',
          text: 'Une notification surgit quand elle arrive, en ligne droite comme au milieu d’un giratoire : c’est le système qui choisit le moment, la conductrice s’adapte.',
        },
      ]}
    />
  </CaseSection>

  <!-- 06 — Le moment ------------------------------------------------- -->
  <CaseSection index="06" label="Recherche" title="La voiture interrompt. Elle pourrait demander son tour." id="moment">
    <p class="t-lead case-lead" data-reveal>
      Épurer les écrans ne suffit pas si la relation reste la même. Aujourd’hui, le système choisit
      le moment et la conductrice s’adapte. Demain, une IA copilote va parler davantage : la vraie
      question devient celle du tour de parole.
    </p>
    <Cards
      columns={2}
      cards={[
        {
          title: 'Un passager s’adapte au trafic',
          text: 'Un passager ajuste la conversation à la situation de conduite, ce que ne fait pas un interlocuteur au téléphone (Drews, Pasupathi et Strayer, 2008).',
        },
        {
          title: 'Deviner le bon moment est fragile',
          text: 'Un modèle qui prédit le moment opportun se trompe environ une fois sur quatre (Kim et al., 2018).',
        },
      ]}
    />
  </CaseSection>

  <!-- 07 — Objectifs ---------------------------------------------------- -->
  <CaseSection index="07" label="Objectifs" title="Trois intentions de design." id="objectifs">
    <Numbered
      items={[
        { title: 'Nouvelle expérience', text: 'Proposer une expérience intuitive et agréable.' },
        { title: 'Centraliser la vue', text: 'Pas d’informations parasites : l’essentiel au même endroit.' },
        {
          title: 'Simplifier l’interface',
          text: 'Identifier les usages clés et réaliser une interface synthétique des besoins utilisateurs.',
        },
      ]}
    />
  </CaseSection>

  <Statement
    kicker="Problématique"
    text="Comment donner à une IA copilote le droit de proposer sans lui donner celui d’interrompre ?"
  />

  <!-- 08 — Benchmark ---------------------------------------------------- -->
  <CaseSection index="08" label="Benchmark 2025–2026" title="Tout le secteur fait parler l’IA. Personne ne règle son tour de parole." layout="full" id="benchmark">
    <ol role="list" class="modes">
      {
        modes.map((m, i) => (
          <li class:list={['modes__item', { 'is-open': i === modes.length - 1 }]} data-reveal style={`--i: ${i}`}>
            <span class="modes__dot" aria-hidden="true" />
            <h3 class="modes__name">{m.mode}</h3>
            <p class="modes__what">{m.what}</p>
            <p class="t-meta modes__refs">{m.refs}</p>
          </li>
        ))
      }
    </ol>
    <p class="t-meta">
      Grille : McFarlane (2002), quatre façons de coordonner une interruption ; la négociation y est la
      meilleure solution d’ensemble.
    </p>
    <div class="table-wrap" data-reveal>
      <table class="refs">
        <caption class="sr-only">Cinq références, datées, avec leurs limites</caption>
        <thead>
          <tr>
            <th scope="col">Référence</th>
            <th scope="col">Date et statut</th>
            <th scope="col">Ce qu’elle fait</th>
            <th scope="col">Limite pour notre question</th>
          </tr>
        </thead>
        <tbody>
          {
            references.map(([ref, date, does, limit]) => (
              <tr>
                <th scope="row">{ref}</th>
                <td>{date}</td>
                <td>{does}</td>
                <td>{limit}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="t-meta">
      Cadre : Euro NCAP 2026 valorise les commandes physiques ; l’avertisseur de distraction par caméra
      est obligatoire sur les véhicules neufs en Europe depuis le 7 juillet 2026.
    </p>
  </CaseSection>

  <!-- 09 — Pistes ------------------------------------------------------- -->
  <CaseSection index="09" label="Exploration" title="Trois façons de régler qui a l’initiative." layout="full" id="pistes">
    <ul role="list" class="pistes">
      {
        pistes.map((p, i) => (
          <li class:list={['piste', { 'is-retained': p.retained }]} data-reveal style={`--i: ${i}`}>
            <p class="piste__head">
              <span class="t-index">{p.n}</span>
              {p.retained && <span class="tag piste__tag">Retenue</span>}
            </p>
            <h3 class="piste__name">{p.name}</h3>
            <p>{p.text}</p>
            <p class="t-meta">Maîtrise : {p.control}</p>
            <p class="piste__note">{p.note}</p>
            <p class="piste__score">
              <span class="piste__total">{p.total}</span>
              <span class="t-meta">/ 30</span>
            </p>
          </li>
        ))
      }
    </ul>
    <p class="t-meta">
      Critères : {criteria.join(', ').toLowerCase()} — notes sur 5, total sur 30 : un jugement de
      conception, pas une mesure. Écartés : le filtrage automatique pur, qui existe depuis 2003 et reste
      opaque ; répondre « en conduisant », trop étroit et ambigu.
    </p>
    <blockquote class="risk" data-reveal>
      <p class="t-meta">Risque principal</p>
      <p>
        La lueur est elle-même une sollicitation. Si elle attire le regard ou presse de répondre, le
        concept échoue : c’est la première chose à tester.
      </p>
    </blockquote>
  </CaseSection>

  <!-- 10 — Solution ----------------------------------------------------- -->
  <section class="solution" data-theme="night" data-surface="dark" aria-labelledby="solution-title">
    <div class="container solution__head">
      <p class="t-meta" data-reveal><span class="t-index">10</span> Solution</p>
      <h2 id="solution-title" class="solution__title" data-lines>
        <span class="line"><span>Main levée</span></span>
      </h2>
      <p class="solution__tag t-serif" data-reveal style="--i: 2">
        L’IA demande la parole. La conductrice la donne.
      </p>
      <p class="t-lead" data-reveal style="--i: 3">
        Un copilote IA prend la forme d’une boule posée sur la planche de bord, à côté d’un bandeau
        d’écran souligné d’un filet lumineux. Il ne parle jamais le premier : il lève la main, et la conductrice choisit quand lui
        répondre.
      </p>
    </div>
    <div class="container">
      <Video
        src="media/main-levee.mp4"
        poster={poster}
        alt="Film Main levée : la conductrice appuie sur la touche micro du volant, le copilote affiche « Je vous écoute », puis propose « Éviter la zone encombrée ? » ; la conductrice valide d’un appui sur la coche et le trajet est mis à jour."
        caption="Film de démonstration — le copilote propose, la conductrice décide"
      />
    </div>
    <div class="container">
      <Numbered
        items={[
          { title: 'L’IA ne parle jamais la première', text: 'Elle lève la main.' },
          { title: 'La conductrice donne la parole', text: 'Quand elle veut. Ou jamais.' },
          { title: 'Une phrase, une proposition, une réponse', text: 'Oui ou non, et l’échange se referme.' },
        ]}
      />
    </div>
    <Figure
      src={habitacleEtats}
      alt="L’habitacle avec le copilote sur la planche de bord et un bandeau qui propose « Un trajet plus calme ? » (Accepter, Plus tard) ; en dessous, la boule en gros plan et ses trois états : veille, écoute, proposition."
      caption="L’habitacle et les trois états de la boule : veille, écoute, proposition"
      sizes="100vw"
      class="bleed"
      lightbox={lb}
    />
  </section>

  <!-- 11 — Le copilote -------------------------------------------------- -->
  <CaseSection index="11" label="Le copilote" title="Une présence, pas un écran de plus." layout="full" id="copilote">
    <Figure
      src={jeVousEcoute}
      alt={project.coverAlt}
      caption="La parole donnée : « Je vous écoute »"
      sizes="(min-width: 1680px) 1600px, 100vw"
      lightbox={lb}
    />
    <div class="split">
      <div class="stack-s">
        <p class="t-lead" data-reveal>
          La boule se personnalise : un visage de compagnon, une onde, ou une forme minimale. Elle
          écoute, propose un détour avec son coût en minutes, et ne se règle qu’à l’arrêt.
        </p>
        <ul role="list" class="tags" data-reveal style="--i: 1">
          {['Écouter', 'Proposer', 'Se personnaliser · à l’arrêt'].map((t) => <li class="tag">{t}</li>)}
        </ul>
      </div>
      <Figure
        src={compagnon}
        alt="Le copilote en version compagnon : visage lumineux souriant, « Bonjour Mélina, où allons-nous ? » à l’écran ; à droite, trois vignettes — écouter (onde sonore), proposer (bifurcation, +3 min), se personnaliser à l’arrêt (Compagnon, Onde, Minimal)."
        caption="Une présence personnalisable"
        sizes="(min-width: 768px) 50vw, 100vw"
        lightbox={lb}
      />
    </div>
  </CaseSection>

  <!-- 12 — Scénario ----------------------------------------------------- -->
  <CaseSection index="12" label="Scénario" title="Un appel au giratoire." id="scenario">
    <ol role="list" class="steps">
      {
        [
          'Un appel arrive au giratoire : une lueur.',
          'Dans le giratoire, elle s’efface.',
          'Route dégagée : un appui sur Parole.',
          '« Maman appelle. Répondre ? »',
          'Oui : l’appel est établi.',
          'Plus tard : non. Gardé pour l’arrêt.',
        ].map((t, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <span class="t-index">{String(i + 1).padStart(2, '0')}</span>
            <span>{t}</span>
          </li>
        ))
      }
    </ol>
  </CaseSection>

  <!-- 13 — États ------------------------------------------------------- -->
  <CaseSection index="13" label="Interface" title="Une lueur, six états." layout="full" id="etats">
    <Cards
      cards={[
        { title: 'Veille', text: 'L’IA est là. Elle n’a rien à dire.' },
        { title: 'Main levée, calme', text: 'Quelque chose attend, sans échéance. Lueur fixe.' },
        { title: 'Main levée, pressant', text: 'Cela va expirer. Respiration lente, jamais de clignotement.' },
        { title: 'Main baissée', text: 'Passage chargé estimé : l’IA s’efface d’elle-même.' },
        { title: 'Parole', text: 'L’échange est ouvert : une phrase, puis oui ou non.' },
        { title: 'Silence', text: 'Rien ne passe jusqu’à l’arrivée, sauf les contacts « toujours immédiats ».' },
      ]}
    />
    <p class="t-body" data-reveal>
      Ni rouge ni orange : ces couleurs restent réservées aux alertes de sécurité, qui ne sont jamais
      retenues.
    </p>
  </CaseSection>

  <!-- 14 — Le volant ---------------------------------------------------- -->
  <CaseSection index="14" label="Le volant" title="Trois touches sous les pouces." layout="full" id="volant">
    <p class="t-lead" data-reveal>
      Au pouce gauche, Parole : donner ou reprendre la parole. Au pouce droit, Oui et Non. Le volant a
      été repensé pour accompagner l’interaction sans quitter la route des yeux.
    </p>
    <Figure
      src={volantDetails}
      alt="Le volant et ses commandes : touche micro et molette à gauche, coche et croix à droite ; détails de l’intégration de la boule et des matières — cuir surpiqué, aluminium brossé, filet lumineux turquoise."
      caption="Commandes au volant, intégration de la boule, matières et finitions"
      sizes="(min-width: 1680px) 1600px, 100vw"
      lightbox={lb}
    />
    <Annotated
      image={volant}
      alt="Rendu 3D du volant, vu de trois quarts, avec ses commandes intégrées."
      lightbox={lb}
      notes={[
        { term: 'Clignotant', text: 'Intégré directement aux branches du volant.' },
        {
          term: 'Flèches de sélection',
          text: 'Ces boutons ont plusieurs fonctionnalités en fonction du mode activé.',
        },
        { term: 'Bouton +/−', text: 'Ajuster, selon le mode actif.' },
        { term: 'Validation', text: 'Deux boutons, ✓ et ✗ : Oui et Non.' },
        { term: 'Roulette', text: 'Au dos de la branche, à portée des doigts.' },
      ]}
    />
    <div class="trio">
      <Figure src={s(31)} alt="Détail du volant : clignotant, flèches de sélection et bouton plus/moins." caption="Commandes gauche" sizes="(min-width: 768px) 33vw, 100vw" lightbox={lb} />
      <Figure src={s(32)} alt="Détail du volant : clignotant et boutons de validation." caption="Commandes droite" sizes="(min-width: 768px) 33vw, 100vw" lightbox={lb} />
      <Figure src={s(33)} alt="Détail du volant : la roulette rouge au dos de la branche." caption="Roulette" sizes="(min-width: 768px) 33vw, 100vw" lightbox={lb} />
    </div>
    <div class="pair">
      <Figure
        src={s(19)}
        alt="Zone sonore conductrice : vue de dessus de l’habitacle, le son diffusé vers la place conductrice."
        caption="Zone sonore conductrice"
        sizes="(min-width: 768px) 50vw, 100vw"
        lightbox={lb}
      />
      <Figure
        src={s(18)}
        alt="Zone sonore passagers : vue de dessus de l’habitacle, le son diffusé vers les places passagers."
        caption="Zone sonore passagers"
        sizes="(min-width: 768px) 50vw, 100vw"
        lightbox={lb}
      />
    </div>
  </CaseSection>

  <!-- 15 — Rôles -------------------------------------------------------- -->
  <CaseSection index="15" label="La place de la conductrice" title="Elle reste pilote : qui décide de quoi." layout="full" id="roles">
    <Cards
      cards={[
        {
          title: 'L’IA fait seule',
          items: ['Retenir et trier', 'Allumer ou baisser la lueur', 'Garder pour l’arrêt', 'Laisser expirer une suggestion périmée'],
