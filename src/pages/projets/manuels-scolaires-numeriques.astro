---
import CaseStudy from '@/layouts/CaseStudy.astro';
import CaseSection from '@/components/case/CaseSection.astro';
import Statement from '@/components/case/Statement.astro';
import Cards from '@/components/case/Cards.astro';
import Figure from '@/components/Figure.astro';
import Video from '@/components/case/Video.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getProject } from '@/data/projects';

import story1 from '@/assets/projects/idf/visuels/story-1.jpg';
import story2 from '@/assets/projects/idf/visuels/story-2.jpg';
import story3 from '@/assets/projects/idf/visuels/story-3.jpg';
import story4 from '@/assets/projects/idf/visuels/story-4.jpg';
import story5 from '@/assets/projects/idf/visuels/story-5.jpg';
import story6 from '@/assets/projects/idf/visuels/story-6.jpg';
import manettePoster from '@/assets/crops/idf-manette-poster.jpg';
import croquis from '@/assets/projects/idf/visuels/croquis.jpg';
import rendus from '@/assets/projects/idf/visuels/rendus.jpg';
import poc from '@/assets/projects/idf/visuels/poc.jpg';
import test from '@/assets/projects/idf/visuels/test.jpg';
import cAnimateur from '@/assets/projects/idf/visuels/c-animateur.jpg';
import cMentor from '@/assets/projects/idf/visuels/c-mentor.jpg';
import cComplice from '@/assets/projects/idf/visuels/c-complice.jpg';
import cCalme from '@/assets/projects/idf/visuels/c-calme.jpg';

const project = getProject('manuels-scolaires-numeriques');
const lb = 'idf';

// Parcours en trois étapes — panneaux du storyboard du dossier.
const journey: { step: string; title: string; text: string; panels: [ImageMetadata, string][] }[] = [
  {
    step: 'Ce que vit l’élève',
    title: 'Décrocher en classe',
    text: 'Devant son manuel, l’élève regarde ailleurs pendant que les autres écrivent. Son enseignante lui présente alors le manuel numérique et sa manette.',
    panels: [
      [story1, 'En classe, un élève rêvasse devant son manuel ouvert pendant que ses camarades écrivent.'],
      [story2, 'Une enseignante lui présente un ordinateur portable et une manette posée sur la table.'],
    ],
  },
  {
    step: 'Ce qu’il utilise',
    title: 'Choisir un compagnon, prendre la manette',
    text: 'Dans le manuel numérique, il choisit son compagnon parmi quatre. La manette s’allume : le joystick et les touches lui servent à parcourir le cours et à répondre.',
    panels: [
      [story3, 'À l’écran, quatre compagnons au choix ; l’élève sélectionne le panda.'],
      [story4, 'Sa main sur le joystick de la manette, dont le liseré s’allume ; l’écran montre la manette et le cours.'],
    ],
  },
  {
    step: 'Ce qu’il obtient',
    title: 'Montrer, expliquer, participer',
    text: 'Il montre son compagnon à un camarade, puis prend la parole devant la classe : le manuel redevient un support d’échange.',
    panels: [
      [story5, 'L’élève montre son écran à un camarade, tous deux souriants.'],
      [story6, 'L’élève explique quelque chose à ses camarades et à son enseignante, la manette posée devant lui.'],
    ],
  },
];

// Le lien entre les trois éléments de la solution.
const system = [
  { name: 'Le manuel numérique', role: 'Le contenu', text: 'Cours et exercices du lycée, dans le navigateur.' },
  { name: 'Le compagnon', role: 'La voix', text: 'Il explique, encourage ou rassure, selon le caractère choisi par l’élève.' },
  { name: 'La manette', role: 'Le corps', text: 'Elle fait ressentir les retours du compagnon — lumière, vibration — et sert à répondre.' },
];

// Les quatre parties annotées dans l'animation Blender.
const manetteParts = [
  ['Boutons haptiques', 'Trois appuis pour les doigts, liseré lumineux.'],
  ['Joystick', 'Navigation à 360° sous le pouce.'],
  ['Coussinet haptique', 'Vibrations ressenties sous la paume.'],
  ['Jeux de lumière', 'Fente animée, liserés et témoin RVB.'],
];

const companions = [
  {
    image: cAnimateur,
    name: 'L’animateur',
    role: 'Fait de l’apprentissage un jeu, utilise l’humour et des défis interactifs.',
    signals: 'Lumières immersives, vibrations scénarisées, voix expressives et bruitages.',
  },
  {
    image: cMentor,
    name: 'Le mentor',
    role: 'Apporte des explications détaillées, donne du contexte historique et scientifique.',
    signals: 'Lumières directionnelles sur les points clés, vibrations légères qui guident sans donner la réponse.',
  },
  {
    image: cComplice,
    name: 'Le complice',
    role: 'Encourage, motive, donne des défis et des récompenses.',
    signals: 'Lumières expressives, vibrations engageantes, réactions audio pleines d’humour.',
  },
  {
    image: cCalme,
    name: 'Le calme',
    role: 'Rassurant, il aide à gérer le stress et propose une approche douce.',
    signals: 'Lumière douce et progressive, vibrations légères, ambiance sonore apaisante.',
  },
];

const personas = [
  ['Aurélien B.', 'TDAH', 'Seconde générale'],
  ['Julie H.', 'Anxieuse', 'Terminale générale'],
  ['Omar T.', 'Facilité', 'Première générale'],
  ['Marie W.', 'Démoralisée', 'Première technologique'],
];
---

<CaseStudy slug={project.slug} surface="light" frameBg="#ffffff">
  <!-- En bref ----------------------------------------------------------- -->
  <section class="brief container" aria-labelledby="brief-title">
    <h2 id="brief-title" class="sr-only">Le projet en bref</h2>
    <dl class="brief__grid">
      <div data-reveal>
        <dt class="t-meta">Besoin</dt>
        <dd>
          Le manuel scolaire, papier ou numérique, reste associé à la fatigue, au stress et aux sacs
          lourds. Le projet cherche à en faire un espace « soigneux » pour l’élève.
        </dd>
      </div>
      <div data-reveal style="--i: 1">
        <dt class="t-meta">Public</dt>
        <dd>Des lycéens, de la seconde à la terminale, aux profils très différents.</dd>
      </div>
      <div data-reveal style="--i: 2">
        <dt class="t-meta">Mon rôle</dt>
        <dd>
          Designer dans une équipe de trois, avec Kevidu D. Kussiyage et Alexandre Vo Thanh. J’ai participé
          à chaque étape : terrain et interviews, personas, POC, compagnons, manette 3D, prototype et test.
        </dd>
      </div>
      <div data-reveal style="--i: 3">
        <dt class="t-meta">Statut du prototype</dt>
        <dd>
          Démo web en ligne, testée avec des utilisateurs ; manette modélisée en 3D (Blender) ; affichage
          test avec QR code dans trois lieux. Le dossier ne présente pas de manette physique.
        </dd>
      </div>
    </dl>
  </section>

  <!-- 01 — Parcours ------------------------------------------------------ -->
  <CaseSection index="01" label="Parcours" title="Du décrochage à la prise de parole." layout="full" id="parcours">
    <ol role="list" class="journey">
      {
        journey.map((j, i) => (
          <li class="journey__step">
            <div class="journey__text" data-reveal>
              <p class="t-index">
                {String(i + 1).padStart(2, '0')} · {j.step}
              </p>
              <h3 class="journey__title">{j.title}</h3>
              <p class="t-body">{j.text}</p>
            </div>
            <ul role="list" class:list={['journey__panels', `journey__panels--${j.panels.length}`]}>
              {j.panels.map(([img, alt], k) => (
                <li data-reveal style={`--i: ${k}`}>
                  <Image
                    src={img}
                    alt={alt}
                    widths={[320, 640]}
                    width={640}
                    sizes="(min-width: 1024px) 30vw, 50vw"
                    format="webp"
                    quality={80}
                    loading="lazy"
                    class="journey__img"
                  />
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
    <p class="t-meta">Storyboard du projet. Les écrans réels sont à découvrir dans la démo.</p>
  </CaseSection>

  <!-- 02 — Choix de conception ------------------------------------------ -->
  <CaseSection index="02" label="Choix de conception" title="Trois décisions, trois besoins." layout="full" id="choix">
    <ol role="list" class="choices">
      <li class="choice" data-reveal>
        <span class="choice__n">01</span>
        <h3 class="choice__title">Une manette qui engage le corps</h3>
        <p><strong>Choix :</strong> touches, joystick, lumières et coussinet haptique, en plus de l’écran.</p>
        <p class="choice__need">
          <span class="t-meta">Besoin documenté</span> « Engager les sens grâce aux interactions sonores et
          gestuelles » et « offrir une nouvelle posture d’apprentissage, différente de la classe ».
        </p>
      </li>
      <li class="choice" data-reveal style="--i: 1">
        <span class="choice__n">02</span>
        <h3 class="choice__title">Quatre compagnons, pas un seul ton</h3>
        <p><strong>Choix :</strong> l’élève choisit entre un animateur, un mentor, un complice et un calme.</p>
        <p class="choice__need">
          <span class="t-meta">Besoin documenté</span> Les personas vont du TDAH à l’anxiété, de la
          démotivation à la facilité ; les objectifs visent une solution qui « s’adapte » et met
          « l’élève au centre ».
        </p>
      </li>
      <li class="choice" data-reveal style="--i: 2">
        <span class="choice__n">03</span>
        <h3 class="choice__title">Des retours qui rassurent</h3>
        <p><strong>Choix :</strong> lumières douces, vibrations légères, feedback instantané et progression visible.</p>
        <p class="choice__need">
          <span class="t-meta">Besoin documenté</span> « Réduction du stress » et « apprentissage ludique »
          pour donner « un sentiment de maîtrise et de satisfaction ».
        </p>
      </li>
    </ol>
  </CaseSection>

  <!-- 03 — Les compagnons ------------------------------------------------ -->
  <CaseSection index="03" label="La solution" title="Un manuel, un compagnon, une manette." layout="full" id="compagnons">
    <ol role="list" class="system" aria-label="Le lien entre le manuel, le compagnon et la manette">
      {
        system.map((n, i) => (
          <li class="system__node" data-reveal style={`--i: ${i}`}>
            <p class="t-meta">{n.role}</p>
            <h3 class="system__name">{n.name}</h3>
            <p>{n.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="system__loop" data-reveal>
      La boucle : le manuel pose l’exercice → le compagnon l’accompagne → la manette le fait ressentir →
      l’élève répond avec la manette → le manuel avance.
    </p>
    <ul role="list" class="companions">
      {
        companions.map((c, i) => (
          <li class="companion" data-reveal style={`--i: ${i}`}>
            <Image
              src={c.image}
              alt={`${c.name}, compagnon IA`}
              widths={[240]}
              width={240}
              sizes="7rem"
              format="webp"
              quality={82}
              loading="lazy"
              class="companion__img"
            />
            <div>
              <h3 class="companion__name">{c.name}</h3>
              <p>{c.role}</p>
              <p class="companion__signals"><span class="t-meta">Sur la manette</span> {c.signals}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <div class="manette">
      <Video
        src="media/manette.mp4"
        poster={manettePoster}
        alt="Animation 3D de la manette : la caméra tourne autour de l’objet et s’arrête sur les boutons haptiques, le joystick, le coussinet haptique et les jeux de lumière."
        caption="Animation Blender — la manette, partie par partie"
      />
      <dl class="manette__parts">
        {
          manetteParts.map(([term, text], i) => (
            <div data-reveal style={`--i: ${i}`}>
              <dt>
                <span class="t-index">{String(i + 1).padStart(2, '0')}</span> {term}
              </dt>
              <dd>{text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="split">
      <Figure
        src={croquis}
        alt="Croquis de recherche de la manette au crayon : plusieurs formes, puis une version annotée avec joystick et lumières."
        caption="Croquis de recherche"
        sizes="(min-width: 768px) 50vw, 100vw"
        framed
        lightbox={lb}
      />
      <Figure
        src={rendus}
        alt="Rendus 3D de déclinaisons de la manette en rose et en jaune, avec boutons et lumières."
        caption="Déclinaisons en 3D"
        sizes="(min-width: 768px) 50vw, 100vw"
        lightbox={lb}
      />
    </div>
  </CaseSection>

  <Statement
    kicker="Problématique"
    text="Comment accompagner l’élève en créant un espace « soigneux / bienveillant » pour son épanouissement scolaire ?"
  />

  <!-- 04 — Recherche ---------------------------------------------------- -->
  <CaseSection index="04" label="Recherche" title="Observations, interviews, POC." layout="full" id="recherche">
    <ul role="list" class="personas" aria-label="Personas issus des interviews">
      {
        personas.map(([name, trait, level], i) => (
          <li data-reveal style={`--i: ${i}`}>
            <span class="personas__trait">{trait}</span>
            <strong>{name}</strong>
            <span class="t-meta">{level}</span>
          </li>
        ))
      }
    </ul>
    <p class="t-meta">Personas issus des interviews. Cadre de réflexion : Joan Tronto, <em>Un monde vulnérable</em> et <em>Caring Democracy</em>.</p>
    <Cards
      cards={[
        { title: 'Simulation multisensorielle', text: 'Augmente l’engagement, réduit la monotonie, répond à divers styles d’apprentissage.' },
        { title: 'Accessibilité', text: 'Permet aux élèves ayant des besoins spécifiques de mieux participer, grâce à des outils adaptés.' },
        { title: 'Réduction du stress', text: 'Des environnements interactifs et bien conçus favorisent l’immersion et la gestion émotionnelle.' },
        { title: 'Apprentissage ludique', text: 'Des outils interactifs donnent un sentiment de maîtrise et de satisfaction.' },
      ]}
    />
    <div class="split">
      <Figure
        src={poc}
        alt="Affiche « Débloque ton compagnon sur le manuel numérique — Scan moi » avec QR code, posée sur un présentoir de médiathèque."
        caption="POC : 55 scans à La Fontaine (Paris), à la médiathèque Landowski (Boulogne-Billancourt) et à Léonard de Vinci (Saint-Germain-en-Laye)"
        sizes="(min-width: 768px) 50vw, 100vw"
        framed
        lightbox={lb}
      />
      <Figure
        src={test}
        alt="Test utilisateur : des élèves essaient la démo web sur ordinateur portable."
        caption="Test utilisateur de la démo"
        sizes="(min-width: 768px) 50vw, 100vw"
        framed
        lightbox={lb}
      />
    </div>
  </CaseSection>

</CaseStudy>

<style>
  .brief {
    padding-block: var(--space-xl) var(--space-m);
  }

  .brief__grid {
    display: grid;
    gap: var(--space-m) var(--col-gap);
  }

  @media (min-width: 768px) {
    .brief__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .brief__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .brief__grid > div {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding-top: var(--space-s);
    border-top: 1px solid var(--border-strong);
  }

  .brief__grid dd {
    color: var(--fg-muted);
  }

  /* Parcours */
  .journey {
    display: grid;
    gap: var(--space-xl);
  }

  .journey__step {
    display: grid;
    gap: var(--space-m) var(--col-gap);
    padding-top: var(--space-m);
    border-top: 1px solid var(--border);
  }

  @media (min-width: 1024px) {
    .journey__step {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .journey__text {
      grid-column: 1 / 5;
    }

    .journey__panels {
      grid-column: 5 / -1;
    }
  }

  .journey__text {
    display: grid;
    gap: var(--space-xs);
  }

  .journey__title {
    font-size: var(--step-2);
    font-stretch: 88%;
  }

  .journey__panels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xs);
  }

  @media (min-width: 768px) {
    .journey__panels--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .journey__panels--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .journey__panels li {
    padding: var(--space-2xs);
    background: #ffffff;
    border: 1px solid var(--border);
  }

  .journey__panels :global(.journey__img) {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  /* Système */
  .system {
    display: grid;
    gap: var(--space-s);
    counter-reset: node;
  }

  @media (min-width: 768px) {
    .system {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-l);
    }
  }

  .system__node {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding: var(--space-m);
    background: #ffffff;
    border: 1px solid var(--border);
    border-top: 3px solid var(--accent);
  }

  .system__node:not(:last-child)::after {
    content: '↓';
    position: absolute;
    left: 50%;
    bottom: calc(var(--space-s) * -1);
    translate: -50% 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--c-ink);
    font-size: 0.9rem;
  }

  @media (min-width: 768px) {
    .system__node:not(:last-child)::after {
      content: '→';
      left: auto;
      right: calc(var(--space-l) * -0.5);
      top: 50%;
      bottom: auto;
      translate: 50% -50%;
    }
  }

  .system__name {
    font-size: var(--step-2);
    font-stretch: 88%;
    line-height: 1.05;
  }

  .system__loop {
    padding-left: var(--space-s);
    border-left: 3px solid var(--accent);
    max-width: 70ch;
    color: var(--fg-muted);
  }

  .manette {
    display: grid;
    gap: var(--space-m) var(--col-gap);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .manette {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
  }

  .manette__parts {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--border-strong);
  }

  .manette__parts > div {
    display: grid;
    gap: var(--space-3xs);
    padding-block: var(--space-s);
    border-bottom: 1px solid var(--border);
  }

  .manette__parts dt {
    display: flex;
    gap: var(--space-xs);
    align-items: baseline;
    font-size: var(--step-1);
    font-weight: 600;
  }

  .manette__parts dd {
    color: var(--fg-muted);
  }

  /* Choix */
  .choices {
    display: grid;
    gap: var(--col-gap);
  }

  @media (min-width: 1024px) {
    .choices {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .choice {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    padding: var(--space-m);
    background: var(--bg-raised);
    border-top: 3px solid var(--accent);
  }

  .choice__n {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent-text);
  }

  .choice__title {
    font-size: var(--step-1);
  }

  .choice__need {
    display: grid;
    gap: var(--space-3xs);
    padding-top: var(--space-xs);
    border-top: 1px solid var(--border);
    color: var(--fg-muted);
  }

  /* Compagnons */
  .companions {
    display: grid;
    gap: var(--space-m) var(--col-gap);
  }

  @media (min-width: 768px) {
    .companions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .companion {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-s);
    align-items: start;
    padding: var(--space-s);
    background: #ffffff;
    border: 1px solid var(--border);
  }

  .companion :global(.companion__img) {
    width: 6rem;
    height: auto;
  }

  .companion__name {
    font-size: var(--step-1);
    margin-bottom: var(--space-3xs);
  }

  .companion__signals {
    display: grid;
    gap: var(--space-3xs);
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--fg-muted);
  }

  .split {
    display: grid;
    gap: var(--space-m) var(--col-gap);
  }

  @media (min-width: 768px) {
    .split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Personas */
  .personas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--col-gap);
  }

  @media (min-width: 1024px) {
    .personas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .personas li {
    display: grid;
    gap: var(--space-3xs);
    padding: var(--space-s);
    background: var(--bg-raised);
  }

  .personas__trait {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1;
    color: var(--accent-text);
  }
</style>
